#cloud-config
# Catalyst Sovereign control-plane bootstrap — CLOUD-AGNOSTIC (#3145).
#
# Sovereign: ${sovereign_fqdn}
# Provider:  ${provider}
# Region:    ${region}
# Provisioned by: catalyst-provisioner (https://console.openova.io/sovereign)
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS IS THE ONE Kubernetes-bootstrap template for EVERY cloud (#3145).
#
# Founder directive 2026-06-09: from k3s upward there is ONE implementation,
# never differentiated per-provider. The Kubernetes layer (k3s install,
# kubeconfig PUT, CNI, gateway-api CRDs, Flux bootstrap, bootstrap secrets) is
# byte-for-byte identical on Hetzner / Huawei / AWS / Azure / GCP / Alibaba.
#
# The ONLY per-provider differences are injected inputs, the template inputs of
# module contract version 1 (infra/providers/_contract/contract.json). The
# template tests no provider name.
#   - node_external_ip_cmd       public-IP discovery (metadata curl vs tofu EIP)
#   - provider_id_cmd            .spec.providerID patch (hcloud vs huawei vs "")
#   - registry_mirror_yaml       /etc/rancher/k3s/registries.yaml body
#   - k3s_extra_args             provider-specific k3s server flags
#   - provider_prelude           runcmd block before k3s (NIC, log self-upload)
#   - cloud_credentials_secret_yaml  flux-system/cloud-credentials Secret body
#   - crossplane_provider_yaml   Crossplane Provider+ProviderConfig (or "")
#   - kubeconfig_put_block       PUT-back runcmd (metadata-IP vs hostname-gated)
#   - provider_substitutes_yaml  extra Flux substitute keys of the pack
#   - node_ipv4_only             IPv6 off and the IPv4 pins of an IPv4-only VPC
#   - fail_mark_cmd              prefix that records a failure marker; the
#                                template appends the marker name
#   - render_region_kustomization  the per-region Kustomization is rendered
#   - gateway_host_network       the Cilium gateway binds node:443/:80
#   - provider_overlay_path      the pack's overlay folder in Git
#   - seal_kind, seal_stanza, seal_node_files, seal_volume_device
#                                the outputs of the pack's seal hook for this
#                                region (contract C8, SEC-152)
#
# CRITICAL STRUCTURAL INVARIANT (#3129 fix): the kubeconfig PUT-back runs
# RIGHT AFTER the k3s apiserver is healthy and BEFORE gateway-api/cilium/flux
# for ALL providers. Nothing downstream (CNI, CRDs, slow GitHub, Flux) can ever
# again block the one time-critical step. Never PUT-late.
# ─────────────────────────────────────────────────────────────────────────────

package_update: true
package_upgrade: false
packages:
  - curl
  - iptables
  - jq
  - ca-certificates
  - git
%{ if enable_fail2ban ~}
  - fail2ban
%{ endif ~}
%{ if enable_unattended_upgrades ~}
  - unattended-upgrades
  - apt-listchanges
%{ endif ~}

write_files:
  # Kernel inotify limits — Flux + bao init churn watches; bump so future
  # blueprints never hit "too many open files".
  - path: /etc/sysctl.d/99-catalyst-inotify.conf
    permissions: '0644'
    content: |
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 1048576
      fs.inotify.max_queued_events = 16384
%{ if node_ipv4_only ~}

  # ── Disable IPv6 (#3840 — the DETERMINISTIC fix for the ghcr image-pull
  # "Try again" wedge that #3837's per-host /etc/hosts pin could not close).
  #
  # ROOT CAUSE (proven live on hw167 worker w5c3dea, 2026-06-19): the Huawei
  # VPC is IPv4-ONLY — the node has NO global IPv6 address — yet IPv6 was left
  # ENABLED in the kernel (disable_ipv6=0). github's ghcr image-blob CDN host
  # `pkg-containers.githubusercontent.com` (where ghcr.io redirects every blob)
  # is dual-stack and resolves to a REAL global AAAA (2606:50c0:8002::154,
  # verified on the node). The Go dual-stack resolver inside containerd/kubelet
  # hands BOTH the A and the unreachable AAAA to the dialer; the IPv6 attempt
  # fails on this IPv4-only VPC and containerd surfaces it as
  # `dial tcp: lookup ghcr.io: Try again` → ImagePullBackOff → the bootstrap
  # flux controllers never start → 0 HelmReleases → permanent fresh-prov wedge.
  #
  # Why #3837 (pin pkg-containers in /etc/hosts) was insufficient: (1) the live
  # failing host is `ghcr.io` itself, pinned nowhere; (2) the flux controllers
  # run on WORKER nodes, whose template pins only harbor/registry — no ghcr
  # host at all; (3) the pin itself depends on the SAME flaky boot-time VPC
  # resolver. Enumerating every image-pull host (ghcr.io + pkg-containers +
  # codeload + harbor + every future registry) is a losing game. Removing the
  # AAAA path entirely is deterministic and host-agnostic: with IPv6 off the
  # resolver returns ONLY A records and containerd never dials IPv6.
  #
  # SAFE on kom4dc (verified): no node has a global IPv6 address, k3s
  # cluster/service CIDRs are IPv4-only, cilium runs ipam.mode=kubernetes with
  # no IPv6 toggles, and ClusterMesh peers over IPv4 EIPs/NodePorts. Nothing
  # on kom4dc uses IPv6. Applied via a sysctl drop-in (survives any later
  # `sysctl --system`) AND `sysctl -w` in the FIRST runcmd item below so it is
  # in effect before the r4() DNS pin, the k3s install, and every image pull.
  # Huawei-gated → the byte-tight Hetzner render stays byte-identical.
  - path: /etc/sysctl.d/99-catalyst-disable-ipv6.conf
    permissions: '0644'
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1
%{ endif ~}

  # ── OS hardening: SSH daemon ──────────────────────────────────────────
  # The operator's only valid path in is the cloud-project SSH key injected
  # via cloud-init authorized_keys. Password auth + root password login off.
  - path: /etc/ssh/sshd_config.d/99-catalyst-hardening.conf
    permissions: '0644'
    content: |
      # Managed by Catalyst Sovereign cloud-init — do not edit by hand.
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitRootLogin prohibit-password
      PermitEmptyPasswords no
      UsePAM yes
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      ClientAliveInterval 300
      ClientAliveCountMax 2
      MaxAuthTries 3
      LoginGraceTime 30

  # No unattended-upgrade configuration here (#7922, INF-060): kured's
  # node-patch-config writes it on every node; a node never reboots itself.

%{ if enable_fail2ban ~}
  # ── fail2ban: sshd jail (defence-in-depth) ────────────────────────────
  - path: /etc/fail2ban/jail.d/catalyst-sshd.local
    permissions: '0644'
    content: |
      [sshd]
      enabled = true
      port = ssh
      filter = sshd
      maxretry = 5
      findtime = 10m
      bantime = 1h
      backend = systemd
%{ endif ~}

  # ── k3s containerd registry mirror — PROVIDER-INJECTED ────────────────
  # Body composed in the provider module from the variables document
  # (SOV-132): each proxy name with this region's registry first and its
  # origin second, and the wildcard "*" with this region's registry alone.
  # k3s reads this at start to configure containerd.
  #
  # CLD-185: this file and two more below (the cloud-credentials Secret and
  # the Crossplane provider) travel packed:
  # `encoding: gz+b64`, the text gzipped and base64-encoded in the template.
  # cloud-init writes the decoded text, the same bytes the plain file had, so
  # the Hetzner render stays under its user_data cap. A provider-injected
  # body loses its comment lines before packing, as the modules strip them
  # from the plain render, and ends with one newline, as the plain block did.
  - path: /etc/rancher/k3s/registries.yaml
    permissions: '0600'
    encoding: gz+b64
    content: ${base64gzip(format("%s\n", chomp(replace(registry_mirror_yaml, "/(?m)^[ ]*#( |$).*\n/", ""))))}

  # ── flux-system/bootstrap-seed: the raw values of the bootstrap Secrets ──
  # SEC-153: one KEY=value line per value, the value base64-encoded so that
  # no character of it can change the YAML Flux substitutes it into (the
  # hand-over key is JSON). runcmd creates the Secret flux-system/bootstrap-seed
  # from this file and shreds it. The Flux Kustomization bootstrap-secrets
  # (clusters/_template/root/base-primary/bootstrap-secrets.yaml), which the kit
  # depends on, renders six Secrets from it (postBuild.substituteFrom):
  # harbor-robot-token, pdm-basicauth, sovereign-tls-secrets,
  # catalyst-handover-jwt-public, ghcr-pull and object-storage; their names,
  # namespaces, types, keys and reflector annotations are files in Git, under
  # clusters/_template/bootstrap-secrets. Only the values must be here: no
  # secret store exists before Flux, and the kit's first pull (ghcr-pull), the
  # catalyst API, the pool-domain calls, the DNS-01 solver, the hand-over check
  # and the registry and backup charts (object-storage) read them from the start.
  # SEC-154: GHCR_PULL_DOCKERCONFIGJSON is the whole .dockerconfigjson, one value
  # under one name; the five OBJECT_STORAGE_* values fill the ten keys of
  # object-storage. cloud-credentials is not in the seed: its manifest is the
  # packed file below, as before.
  - path: /var/lib/catalyst/bootstrap-seed.env
    permissions: '0600'
    content: |
      HARBOR_ROBOT_TOKEN=${base64encode(harbor_robot_token)}
      PDM_BASIC_AUTH_USER=${base64encode(pdm_basic_auth_user)}
      PDM_BASIC_AUTH_PASS=${base64encode(pdm_basic_auth_pass)}
      POWERDNS_API_KEY=${base64encode(powerdns_api_key)}
      HANDOVER_JWT_PUBLIC_KEY=${base64encode(handover_jwt_public_key)}
      GHCR_PULL_DOCKERCONFIGJSON=${base64encode(jsonencode({ auths = { "ghcr.io" = { username = ghcr_pull_username, password = ghcr_pull_token, auth = ghcr_pull_auth_b64 } } }))}
      OBJECT_STORAGE_ENDPOINT=${base64encode(object_storage_endpoint)}
      OBJECT_STORAGE_REGION=${base64encode(object_storage_region)}
      OBJECT_STORAGE_BUCKET=${base64encode(object_storage_bucket_name)}
      OBJECT_STORAGE_ACCESS_KEY=${base64encode(object_storage_access_key)}
      OBJECT_STORAGE_SECRET_KEY=${base64encode(object_storage_secret_key)}

  # ── flux-system/cloud-credentials Secret — PROVIDER-INJECTED ──────────
  # Vendor-agnostic name (#425). Body composed per-provider in main.tf:
  #   Hetzner → hcloud-token (+ autoscaler hcloud-* keys).
  #   Huawei  → huawei-ak / huawei-sk / huawei-project-id / huawei-region.
  # Crossplane Provider + any Day-2 controller reads these keys.
  - path: /var/lib/catalyst/cloud-credentials-secret.yaml
    permissions: '0600'
    encoding: gz+b64
    content: ${base64gzip(format("%s\n", chomp(replace(cloud_credentials_secret_yaml, "/(?m)^[ ]*#( |$).*\n/", ""))))}

%{ if crossplane_provider_yaml != "" ~}
  # ── Crossplane Provider + ProviderConfig — PROVIDER-INJECTED ──────────
  # Applied (best-effort) after Flux brings up bp-crossplane core CRDs.
  # Empty string on providers without a Crossplane provider package yet.
  - path: /var/lib/catalyst/crossplane-provider.yaml
    permissions: '0644'
    encoding: gz+b64
    content: ${base64gzip(format("%s\n", chomp(replace(crossplane_provider_yaml, "/(?m)^[ ]*#( |$).*\n/", ""))))}
%{ endif ~}

  # ── OpenBao seal: key files and seal profile (contract C8, SEC-152) ───
  # docs/contracts/c8-seal-provider.md, actions 1 and 4. The four inputs
  # seal_kind, seal_stanza, seal_node_files and seal_volume_device are the
  # outputs of the pack's seal hook for this region. Why here and not in Flux
  # or OpenBao: the key opens OpenBao, so it must be on the node before
  # OpenBao's first start, and no secret store exists yet to deliver it.
  # Action 1: each node file is staged under /run (memory-backed, so the key
  # never touches the system disk); the runcmd step before the k3s install
  # moves it to its path under /var/lib/catalyst/seal.
%{ for f in seal_node_files ~}
  - path: /run/catalyst-seal-stage/${basename(f.path)}
    permissions: '0400'
    encoding: b64
    content: ${f.content_b64}
%{ endfor ~}
  # Action 4: ConfigMap flux-system/sovereign-seal-profile, applied with the
  # bootstrap Secrets below. It holds no key bytes: the stanza names the key
  # file, which the bp-openbao chart mounts from /var/lib/catalyst/seal.
  - path: /var/lib/catalyst/sovereign-seal-profile.yaml
    content: |
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: sovereign-seal-profile
        namespace: flux-system
      data:
        kind: ${seal_kind}
        stanza: |
          ${indent(10, chomp(seal_stanza))}

  # ── Cilium Helm values (one structured file; same on every cloud) ─────
  # kubeProxyReplacement + gateway-api + envoy + wireguard node-encryption.
  # k8sServiceHost = the CP's PRIVATE IP. We write the sentinel
  # NODE_IP_PLACEHOLDER and sed-substitute the runtime-detected NODE_IP just
  # before the helm install — because some clouds (Huawei HCS) assign the
  # private IP via non-deterministic DHCP, so a tofu-baked guess is wrong.
  # node_ip_cmd discovers it identically on every cloud (hard-dependency-free).
  # #7893: packed (gz+b64) as flux-bootstrap.yaml below is, with the same
  # expression and the same rules for the body; the runcmd sed that sets
  # NODE_IP_PLACEHOLDER runs on the file cloud-init has written.
  - path: /var/lib/catalyst/cilium-values.yaml
    permissions: '0644'
    encoding: gz+b64
    content: ${base64gzip(format("%s\n", chomp(replace(replace(<<CILIUMVALUES
      cluster:
        name: "${cluster_mesh_name}"
        id: ${cluster_mesh_id}
      kubeProxyReplacement: true
      k8sServiceHost: NODE_IP_PLACEHOLDER
      k8sServicePort: 6443
      # #4656: NATIVE routing (not vxlan) so WireGuard node-encryption does not
      # double-encapsulate. VXLAN-inside-WireGuard is unfixable by any MTU —
      # pinning MTU makes cilium derive wg0 = MTU-80, so pod(MTU)+50(VXLAN)
      # always exceeds wg0 (proven live on hw224: host 1370 + 50 > wg0 1290).
      # Nodes are L2-adjacent within a region so autoDirectNodeRoutes installs
      # cross-node pod routes with no tunnel. The native CIDR is the pod
      # supernet of the Sovereign (NET-110), the range the Flux release of
      # slot 01 sets from CILIUM_NATIVE_ROUTING_CIDR below.
      routingMode: native
      ipv4NativeRoutingCIDR: "${pod_supernet}"
      autoDirectNodeRoutes: true
      bpf:
        masquerade: true
      ipam:
        mode: kubernetes
      encryption:
        enabled: true
        type: wireguard
      gatewayAPI:
        enabled: true
        gatewayClass:
          # Force GatewayClass creation regardless of CRD presence at Helm
          # render time (cilium-gateway-race #503). "auto" skips creation
          # when the gateway.networking.k8s.io CRDs are not yet present.
          create: "true"
%{ if gateway_host_network ~}
        # #4706 no-CCM Huawei: envoy binds node:443/:80; ELB targets them.
        # Lockstep w/ CILIUM_GATEWAY_HOSTNETWORK_ENABLED (parity test).
        hostNetwork:
          enabled: true
%{ endif ~}
      envoy:
        enabled: true

      envoyConfig:
        enabled: true
      l7Proxy: true
      hubble:
        enabled: true
        relay:
          enabled: false
        ui:
          enabled: false
        metrics:
          enabled: null
          serviceMonitor:
            enabled: false
      l2announcements:
        enabled: false
      operator:
        replicas: 1
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          memory: 1Gi
      prometheus:
        enabled: false
        serviceMonitor:
          enabled: false
CILIUMVALUES
    , "/(?m)^[ ]*#( |$).*\n/", ""), "/(?m)^      /", ""))))}

  # ── Variables document (contract C5) ──────────────────────────────────
  # SOV-134: the template input `variables`, the variables document of
  # contract C5 (docs/contracts/c5-upstream-variables.schema.json), one
  # KEY=value line per key in key order. No key holds a secret. It travels
  # packed (gz+b64), as the files above; cloud-init writes the plain text.
  # The runcmd item that applies flux-bootstrap.yaml first creates ConfigMap
  # flux-system/sovereign-variables from this file with `kubectl create`,
  # which records no last-applied state, so the apply that follows adds the
  # kit keys of flux-bootstrap.yaml and removes none of these keys.
  - path: /var/lib/catalyst/variables.env
    permissions: '0600'
    encoding: gz+b64
    content: ${base64gzip(join("", [for k, v in variables : "${k}=${v}\n"]))}

  # ── Node artifacts from the origin registry ───────────────────────────
  # SOV-142: oci_fetch <repository> <tag> <output> <upstream address>
  # fetches one node artifact from the origin registry of the variables
  # document above: repository <REGISTRY_PATH_NODE_ARTIFACTS>/<repository>
  # on <ORIGIN_REGISTRY_SCHEME>://<ORIGIN_REGISTRY_HOST>. It asks for the
  # manifest (on 401 it takes a pull token from the realm the registry
  # names), reads the digest of the first layer, downloads that layer and
  # writes <output> only when the layer's SHA-256 equals that digest. When
  # the origin does not serve the manifest (no host, no answer, a refused
  # token, or any status but 200) and NODE_ARTIFACT_FALLBACK is true, it
  # downloads <output> from <upstream address>, the address the node used
  # before, and logs that it did; SOV-510 changes that default to false. A
  # layer that fails to download or to match is a failure, never a
  # fallback. The script exits non-zero on failure by the status of its
  # last command. Three artifacts, called in runcmd below, all before Flux
  # exists: k3s-install (tag: k3s_version with + as -), and
  # gateway-api-experimental-install and flux-install (tag: the upstream
  # release). Packed like its neighbours, so the script holds no comment;
  # SOV-153 writes it plain with the other packed entries.
  - path: /var/lib/catalyst/oci_fetch
    permissions: '0700'
    encoding: gz+b64
    content: ${base64gzip(<<-EOT
      #!/bin/sh
      NODE_ARTIFACT_FALLBACK=true
      v() { sed -n "s/^$1=//p" /var/lib/catalyst/variables.env; }
      h=$(v ORIGIN_REGISTRY_HOST) r=$(v REGISTRY_PATH_NODE_ARTIFACTS)/$1 o=$3.oci s= t=
      u=$(v ORIGIN_REGISTRY_SCHEME)://$h/v2/$r
      trap 'rm -f $o $o.h' 0
      c="curl -sS --connect-timeout 10 -m 300"
      m="Accept: application/vnd.oci.image.manifest.v1+json"
      if [ -n "$h" ]; then
        s=$($c -o $o -D $o.h -w '%%{http_code}' -H "$m" $u/manifests/$2)
        if [ "$s" = 401 ]; then
          t=$($c -f "$(tr -d '\r' < $o.h | sed -n 's/.*realm="\([^"]*\)",service="\([^"]*\)".*/\1?service=\2/p')&scope=repository:$r:pull" | jq -r .token)
          s=$($c -o $o -w '%%{http_code}' -H "$m" -H "Authorization: Bearer $t" $u/manifests/$2)
        fi
      fi
      if [ "$s" = 200 ]; then
        d=$(jq -r '.layers[0].digest' $o)
        $c -fL -o $o $${t:+-H "Authorization: Bearer $t"} $u/blobs/$d && [ "sha256:$(sha256sum $o | cut -d' ' -f1)" = "$d" ] && mv $o $3 && exit
        echo "oci_fetch: $1:$2: bad layer $d" >&2
        false
      else
        echo "oci_fetch: $1:$2 not at the origin ($s), fallback $NODE_ARTIFACT_FALLBACK: $4" >&2
        [ "$NODE_ARTIFACT_FALLBACK" = true ] && curl -fsSL --max-time 60 $4 -o $3
      fi
      EOT
    )}

  # ── Flux bootstrap: GitRepository + one root Kustomization ────────────
  # From here Flux owns the cluster. The postBuild.substitute map threads
  # every Sovereign-shape value into clusters/_template/bootstrap-kit/*.
  # The substitutes that differ per cloud (HCLOUD_HR_SUSPEND vs
  # HUAWEI_HR_SUSPEND, the registry-mirror endpoint, the PDNS host) are
  # the input provider_substitutes_yaml (CLD-131): each provider module
  # renders its own provider-substitutes.yaml.tftpl and passes the text,
  # which the ConfigMap sovereign-variables below writes in.
  #
  # #7893: this document travels packed (`encoding: gz+b64`), as the files
  # above do since CLD-185. It was about 7,160 of the 30,850 bytes of the
  # reference control-plane render, and a real two-region Huawei
  # installation rendered 32,931 bytes, over the 32,768 bytes of raw
  # user data the Huawei ECS API accepts. Packed it is about 2,300 bytes.
  # The body below is the same text as before, indented six spaces as the
  # YAML literal block was. Before packing, the expression drops its comment
  # lines with the regex the modules apply to the plain render, removes the
  # six-space indent the YAML parser removed, and ends it with one newline
  # (YAML clip chomping). cloud-init writes the decoded text, so the file on
  # the node is byte for byte the file the plain block gave; the golden
  # file hashes in infra/providers/_shared/tests prove it. Keep every body
  # line indented at least six spaces (a directive line at column 0 is
  # fine: it renders no text), and keep the marker line FLUXBOOTSTRAP
  # alone at column 0.
  # SEC-040: mode 0600; runcmd shreds the file once its apply succeeded.
  - path: /var/lib/catalyst/flux-bootstrap.yaml
    permissions: '0600'
    encoding: gz+b64
    content: ${base64gzip(format("%s\n", chomp(replace(replace(<<FLUXBOOTSTRAP
      apiVersion: source.toolkit.fluxcd.io/v1
      kind: GitRepository
      metadata:
        name: openova
        namespace: flux-system
      spec:
        interval: 1m
        # CLONE BUDGET (issue #6336) — this is source-controller's whole-reconcile
        # deadline, NOT the kustomize-controller revision-lock knob issue #492
        # governs. Never "harmonise" it down to 5m by analogy: a GitRepository
        # holds no revision lock, so a longer deadline costs nothing on the happy
        # path, while a short one produces ZERO HelmReleases forever.
        #
        # Measured on hw297 region-b, 2026-08-14: with the field ABSENT the CRD
        # default of 60s applies (source-controller v1.4.1 CRD:
        # `spec.timeout` default "60s"), and every reconcile died at
        #   `failed to checkout and determine revision: unable to clone
        #    'https://github.com/openova-io/openova': context deadline exceeded`
        # -> bootstrap-kit / bootstrap-kit-crs / sovereign-tls all stuck on
        # `Source artifact not found` -> `kubectl get helmrelease -A` empty ->
        # the Phase-1 watch reported 0 HelmReleases and the prov froze.
        # Patching ONLY this field to 10m on the live cluster produced
        # `13:41:33Z building artifact` -> `13:52:24Z ready=True
        # rev=main@sha1:e050028da1634e` — 651s (10m51s) for one clone.
        #
        # WHY THE CLONE IS THAT EXPENSIVE, and why `ignore:` below does not help:
        # source-controller v1.4.1 ALREADY shallow-clones unconditionally
        # (internal/controller/gitrepository_controller.go: `cloneOpts :=
        # repository.CloneConfig{... ShallowClone: true}`) and the v1 CRD exposes
        # NO depth / shallow / sparse-checkout knob to tune — so the history is
        # already excluded and cannot be excluded any further from here. What
        # crosses the wire is the depth-1 tree at HEAD: 449 MB, of which
        # docs/ is 373 MB (docs/sessions alone 338 MB). `ignore:` is an
        # ARTIFACT-BUILD filter applied AFTER checkout, so it never shrinks the
        # transfer. 449 MB / 651 s => ~0.69 MB/s effective on that link.
        #
        # 20m = 1.84x the measured 651s. Floor: it must clear a real observed
        # clone with room for the tree to grow (docs/sessions grows every walk)
        # or the link to halve. Ceiling: it must stay well inside the 60m
        # DefaultWatchTimeout of the Phase-1 HelmRelease watch so a genuinely
        # unreachable origin still fails visibly INSIDE the watch window rather
        # than in one endless attempt. A retry cannot rescue a slow clone (each
        # attempt re-clones from scratch at the same speed), so single-attempt
        # headroom is what matters; retry count is not.
        #
        # This moves the cliff, it does not remove it: at a fixed timeout, repo
        # growth eventually crosses any value. The durable removal is to stop
        # carrying hundreds of MB of walk evidence in the reconciled tree.
        # Guarded by scripts/check-gitrepository-clone-timeout.sh.
        timeout: 20m
        url: ${gitops_repo_url}
        ref:
          branch: ${gitops_branch}
        ignore: |
          /*
          !/clusters/_template
          !/platform
          !/products
      ---
      # SOV-154: the one root Kustomization. Its children (bootstrap-secrets,
      # bootstrap-kit, sovereign-tls, bootstrap-kit-crs, sovereign-region-bootstrap,
      # infrastructure-providers) are files under clusters/_template/root; the
      # path names the folder root/<region layout>-<region role>, or, for a
      # pack that renders no region Kustomization, root/<region role> of its
      # overlay. No wait (false) and no timeout: it never holds a child behind health.
      apiVersion: kustomize.toolkit.fluxcd.io/v1
      kind: Kustomization
      metadata:
        name: sovereign-root
        namespace: flux-system
      spec:
        interval: 5m
        retryInterval: 1m
        path: %{ if render_region_kustomization }./clusters/_template/root/%{ if replica_region_canonical_label == "" }base%{ else }%{ if region_canonical_label == primary_region_canonical_label }multi-region%{ else }multi-region-follower%{ endif }%{ endif }-%{ else }${provider_overlay_path}/root/%{ endif }${sovereign_region_role}
        prune: true
        sourceRef:
          kind: GitRepository
          name: openova
        postBuild:
          substituteFrom:
            - kind: ConfigMap
              name: sovereign-variables
      ---
      # SOV-130: ConfigMap sovereign-variables holds every value that the
      # root Kustomization and its children substitute (postBuild.substituteFrom).
      # Flux reads it only after the GitRepository above has an artifact, so it
      # exists by then although bootstrap-kit is applied a moment earlier.
      # The one secret value, POWERDNS_API_KEY, is not here: it is the Secret
      # flux-system/sovereign-tls-secrets, which the Kustomization
      # bootstrap-secrets renders from the seed Secret flux-system/bootstrap-seed
      # (file bootstrap-seed.env, SEC-153).
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: sovereign-variables
        namespace: flux-system
      data:
            SOVEREIGN_FQDN: ${sovereign_fqdn}
            SOVEREIGN_FQDN_DASHED: ${sovereign_fqdn_slug}
            PROVIDER: ${provider}
%{ if provider_api_cidrs_yaml != "[]" ~}
            # #5017 step-08 deny-egress provider-API allow (docs: infra vars).
            PROVIDER_API_CIDRS_YAML: '${provider_api_cidrs_yaml}'
%{ endif ~}
            SOVEREIGN_DEPLOYMENT_ID: ${deployment_id}
            # #4236 console-ELB IPv4 → slot-13 sovereignConsoleLBIP (see that file).
            # Quoted (SOV-130): with no console ELB the value is empty, and a
            # ConfigMap value must be a string, never null.
            SOVEREIGN_CONSOLE_LB_IP: "${console_load_balancer_ipv4}"
            # #4053 console-isolation toggle (Refs #4431 #4212) → slot-13
            # ingress.gateway.parentRef.name. When console_isolation_enabled is
            # "true" (default) the console HTTPRoutes parent the DEDICATED
            # cilium-gateway-console (poison-proof CEC isolation). When "false"
            # (a 3-EIP single-region validation prov that drops the console ELB)
            # they re-parent onto the SHARED cilium-gateway so the console still
            # resolves at the primary LB IP (no #4070-shape 404-with-TLS-green).
            SOVEREIGN_CONSOLE_GATEWAY: "${console_isolation_enabled == "true" ? "cilium-gateway-console" : "cilium-gateway"}"
            # #4236/#4179: primary LB IPv4 → slot-13 sovereignLBIP → ConfigMap lbIP
            # (was undeclared here → lbIP empty → org-controller pool-DNS skip).
            SOVEREIGN_LB_IP: ${load_balancer_ipv4}
            # #4330 — primary LB IPv4 → slot-13 sovereign.controlPlaneIP →
            # ConfigMap controlPlaneIP key. The #1844 design intent (documented
            # in products/catalyst/chart/Chart.yaml) was to source this from
            # load_balancer_ipv4 — "the canonical operator-facing CP IP" — but
            # the substitute line was never actually added to this consolidated
            # shared template, so controlPlaneIP rendered EMPTY on EVERY Sovereign
            # (even a fresh prov). load_balancer_ipv4 is the right source: it is
            # the only CP-class IP uniformly known at tofu-apply / template-render
            # time on BOTH providers (Hetzner resolves the raw CP node IP only at
            # runtime via metadata → node_external_ip_value is "" here), and it is
            # the operator-facing entry point the Settings page surfaces. Without
            # this the catalyst-api SOVEREIGN_CONTROL_PLANE_IP env (and the
            # Settings page controlPlaneIP) stay blank.
            SOVEREIGN_CONTROL_PLANE_IP: ${load_balancer_ipv4}
            # SOVEREIGN_OWNER_EMAIL (founder NS-3 #3263) — the deployment
            # owner's email (the same org_email as ORG_EMAIL below).
            # bp-keycloak slot 09 threads it into sovereignRealm.ownerEmail;
            # the sovereign-realm import seeds that user into
            # /sovereign-admins at bootstrap so the owner is admin-by-default
            # across grafana/gitea/harbor/openbao on first SSO login.
            SOVEREIGN_OWNER_EMAIL: "${org_email}"
            # ORG_EMAIL / ORG_NAME (#3374 Layer-B, 2026-06-17) — bp-catalyst-
            # platform slot 13 reads $${ORG_EMAIL:-} / $${ORG_NAME:-} into
            # sovereign.{orgEmail,orgName}, which the chart writes to the
            # sovereign-fqdn ConfigMap orgEmail/orgName keys -> the
            # catalyst-api OPERATOR_EMAIL/ORG_NAME env. The map previously
            # only carried SOVEREIGN_OWNER_EMAIL (for bp-keycloak), so
            # $${ORG_EMAIL:-} resolved to EMPTY -> OPERATOR_EMAIL unset ->
            # the owner UserAccess seed was skipped (D21: /users rendered
            # empty) and no privilege outcome could key on the operator
            # email. Same org_email/org_name tofu values as above — one
            # source, now threaded to BOTH the realm seed and the
            # catalyst-api operator-identity envs. Measured root cause on
            # hw150 (#3374 section 3-b: orgEmail empty).
            ORG_EMAIL: "${org_email}"
            ORG_NAME: "${org_name}"
            # SOVEREIGN_REGION_KEY — the bp-openova-flow-emitter REGION_KEY env
            # (slot 57). Provider-supplied: Hetzner passes the raw region key
            # (var.region / secondary each.key); Huawei passes the canonical
            # label (hw-<code>-rtz-prod). Both preserved from the pre-#3145
            # per-provider templates.
            SOVEREIGN_REGION_KEY: ${sovereign_region_key}
            MARKETPLACE_ENABLED: "${marketplace_enabled}"
            QA_FIXTURES_ENABLED: "${qa_fixtures_enabled}"
            # FIRE_CUTOVER_ON_HANDOVER (North Star — decouple cutover auto-fire
            # from qaTestEnabled) — bootstrap-kit slot-13 reads this into
            # catalystApi.fireCutoverOnHandover, which the chart ORs with
            # qaFixtures.enabled (#4648) to set CATALYST_FIRE_CUTOVER_ON_HANDOVER
            # on the child catalyst-api. INDEPENDENT of QA_FIXTURES_ENABLED so a
            # PROD-cert Sovereign (qa_fixtures_enabled=false) can ALSO auto-fire
            # the cutover on handover and reach cutoverComplete with ZERO manual
            # steps. SOV-133: the value is HANDOVER_AUTO of the template input
            # `variables`, the variables document of contract C5
            # (docs/contracts/c5-upstream-variables.schema.json).
            FIRE_CUTOVER_ON_HANDOVER: "${variables["HANDOVER_AUTO"]}"
            PARENT_DOMAINS_YAML: '${parent_domains_yaml}'
            # PARENT_DOMAINS_FILTER (#3376) — the external-dns domainFilters
            # list (bootstrap-kit slot 12, clusters/_template/bootstrap-kit/
            # 12-external-dns.yaml). Pre-#3376 the filter was ONLY the
            # Sovereign FQDN, so external-dns IGNORED the per-Org HTTPRoute
            # hostnames `console.<slug>.<pool-tld>` / `<app>.<slug>.<pool-tld>`
            # (under the role=sme-pool parent zones omani.homes/.rest/.trade)
            # and never wrote their A records → NXDOMAIN → CONNECTION_REFUSED.
            # Deriving the filter from EVERY parent zone lets external-dns
            # manage the tenant subdomains too.
            #
            # SIZE (#3793 → Refs #3376): emit this key ONLY when the Sovereign
            # brought >1 parent zone (i.e. sme-pool zones beyond the primary
            # FQDN). When there is just the single primary zone — the default
            # zero-touch flow + every single-zone prov — 12-external-dns.yaml's
            # envsubst default $${PARENT_DOMAINS_FILTER:-["$${SOVEREIGN_FQDN}"]}
            # already renders the byte-identical ["<fqdn>"], so omitting the
            # key here is behavior-preserving AND reclaims the ~44 cloud-init
            # bytes that pushed the 3-region render past Hetzner's 32256 guard
            # (hard cap 32768). The filter is only NEEDED in the multi-zone
            # pool case, which is exactly when it is emitted.
%{ if length(distinct([for z in yamldecode(parent_domains_yaml) : z.name])) > 1 ~}
            PARENT_DOMAINS_FILTER: '${jsonencode(distinct([for z in yamldecode(parent_domains_yaml) : z.name]))}'
%{ endif ~}
            # TENANT_PARENT_DOMAIN (#3374 #3988, Refs #6504) — the single
            # org-pool TLD new Organizations default to for their per-Org
            # console + app subdomains (console.<slug>.<pool-tld>). bootstrap-kit
            # slot-13 threads this into bp-catalyst-platform's
            # orgServices.provisioning.tenantParentDomain ($${TENANT_PARENT_DOMAIN:-});
            # the per-Org provisioning consumer stamps spec.tenantPublic ONLY when
            # it is set, so WITHOUT it every customer Org mints with NO public
            # route and the customer console + purchased app return
            # ERR_CONNECTION_REFUSED — the funnel-terminal failure #3859 fixed the
            # chart wiring for, but the $${TENANT_PARENT_DOMAIN} substitute itself
            # was never emitted, so the value stayed empty on every Sovereign.
            # Derived from the FIRST role==org-pool zone in the SAME
            # parent_domains_yaml the parentZones substitute uses (single source →
            # tenantParentDomain can never diverge from the zones bp-keycloak #6504
            # renders console.*.<zone>/* catalyst-ui callbacks for). Emitted ONLY
            # when an org-pool zone exists, so a single-zone Sovereign renders
            # byte-identically (slot-13 default $${TENANT_PARENT_DOMAIN:-} → "").
            # Go mirror: provisioner.Request.TenantParentDomain().
%{ if length([for z in yamldecode(parent_domains_yaml) : z.name if z.role == "org-pool"]) > 0 ~}
            TENANT_PARENT_DOMAIN: '${[for z in yamldecode(parent_domains_yaml) : z.name if z.role == "org-pool"][0]}'
%{ endif ~}
            SOVEREIGN_CNPG_INSTANCES: "${sovereign_cnpg_instances}"
            CONTINUUM_ENABLED: "${continuum_enabled}"
            CLUSTER_MESH_NAME: "${cluster_mesh_name}"
            CLUSTER_MESH_ID: "${cluster_mesh_id}"
            # Runtime-substituted from NODE_IP_PLACEHOLDER (see cilium-values).
            CILIUM_K8S_SERVICE_HOST: "NODE_IP_PLACEHOLDER"
            # NET-110: the pod supernet; slot 01 routes it natively.
            CILIUM_NATIVE_ROUTING_CIDR: "${pod_supernet}"
            SOVEREIGN_REGION_CANONICAL_LABEL: "${region_canonical_label}"
            QA_PRIMARY_REGION: "${primary_region_canonical_label}"
            SOVEREIGN_PRIMARY_REGION: "${primary_region_canonical_label}"
            SOVEREIGN_REPLICA_REGION: "${replica_region_canonical_label}"
            SOVEREIGN_ENABLE_HOT_STANDBY: "${enable_hot_standby}"
            # ADR-0010 #3188 master gate for bootstrap-kit slot 16a shared-pg.
            SOVEREIGN_ENABLE_SHARED_PG: "${enable_shared_pg}"
            # #3285 one-flag contract: enabling the shared engine ALSO flips
            # both consumers to SHARED mode (skip their bundled CNPG; bind
            # the reflected <consumer>-database-secret off shared-pg).
            # Proven necessary on hw129 (2026-06-11, the first
            # SHARED_PG=true prov): the engine + Database CRs + hub Secrets
            # all materialized, but gitea/harbor still rendered their OWN
            # gitea-pg/harbor-pg clusters because these per-consumer flips
            # were a documented-but-manual second step — the founder-visible
            # "1 engine, 2 consumers" card cannot exist zero-touch without
            # them. tofu's enable_shared_pg is the string "true"/"false", so
            # the inverse is computed here template-side.
            SOVEREIGN_GITEA_PG_OWN_CLUSTER: "${enable_shared_pg == "true" ? "false" : "true"}"
            SOVEREIGN_HARBOR_PG_OWN_CLUSTER: "${enable_shared_pg == "true" ? "false" : "true"}"
            # The companion seams the slots default to own-cluster values
            # (host/secret). In SHARED mode they must point at the shared
            # engine + the reflected hub Secret (#3284) or the consumers
            # would skip their bundled cluster yet still dial it.
            #
            # #4158 cross-region host: gitea/harbor/keycloak run INSIDE vc-mgmt
            # and read this host as a scalar (bitnami externalDatabase.host /
            # an env value — NOT a secretKeyRef, so they cannot pick up the
            # topology-aware `host` key bp-postgres bakes into the hub Secret
            # the way grafana's hostPortKey does). The region-LOCAL `<instance>-rw`
            # Service exists ONLY where the primary Cluster runs, so a SECONDARY
            # control plane that dials `shared-pg-rw` gets NXDOMAIN (measured live
            # on dep 4635277cae4ffed9 region-B: keycloak-0 `cannot resolve host
            # shared-pg-rw…`, harbor-core/jobservice CrashLoop on the same). The
            # ClusterMesh-global WRITE alias `shared-pg-mesh-rw` (bp-postgres
            # publishes it on the primary as a `service.cilium.io/global` managed
            # Service + a same-named replica stub) resolves in BOTH regions and
            # routes writes to the current primary — and bp-continuum re-homes the
            # `rw` selector on failover, so the host needs no change on promotion.
            # #6874 D3: keyed on the MULTI-REGION signal (replica_region_canonical_label
            # non-empty — the SAME signal bp-postgres.meshGlobalServices renders the
            # alias on, stamped as SOVEREIGN_REPLICA_REGION above), NOT on the region
            # role. Until now the PRIMARY kept the region-local `-rw` and the
            # post-mesh catalyst-api re-stamp (clustermesh.go) touches SECONDARIES
            # only, so region A's gitea/harbor/keycloak dialed `shared-pg-rw` for
            # the life of the Sovereign. hw307 (2026-09-07 07:26-07:55Z): after the
            # dr-failback actor demoted region A, `shared-pg-rw` was a READ-ONLY
            # standby of region B's promoted cluster and those three consumers
            # logged `cannot execute ... in a read-only transaction` (gitea 45/5min,
            # keycloak 28/5min) until a manual switchback. `shared-pg-mesh-rw` is
            # CNPG-managed with real local backends on the steady primary (resolves
            # on region A from the first reconcile, before the mesh peers) and the
            # primary-demoted stub routing cross-mesh to region B after a demotion,
            # so the host follows the WRITABLE side with no consumer change. A
            # single-region prov (empty replica label → bp-postgres renders no
            # alias) keeps `-rw`, byte-identical.
            SOVEREIGN_GITEA_PG_HOST: "${enable_shared_pg == "true" ? (replica_region_canonical_label == "" ? "shared-pg-rw.shared-data.svc.cluster.local" : "shared-pg-mesh-rw.shared-data.svc.cluster.local") : "gitea-pg-rw.gitea.svc.cluster.local"}"
            SOVEREIGN_GITEA_PG_SECRET: "${enable_shared_pg == "true" ? "gitea-database-secret" : "gitea-pg-app"}"
            SOVEREIGN_HARBOR_PG_HOST: "${enable_shared_pg == "true" ? (replica_region_canonical_label == "" ? "shared-pg-rw.shared-data.svc.cluster.local" : "shared-pg-mesh-rw.shared-data.svc.cluster.local") : "harbor-pg-rw.harbor.svc.cluster.local"}"
            # #4158: keycloak (slot 09 externalDatabase.host) had NO host var —
            # it fell to the slot's bare `:=shared-pg-rw` default, which NXDOMAINs
            # on the SECONDARY. Same cross-region treatment as gitea/harbor above.
            SOVEREIGN_KEYCLOAK_PG_HOST: "${enable_shared_pg == "true" ? (replica_region_canonical_label == "" ? "shared-pg-rw.shared-data.svc.cluster.local" : "shared-pg-mesh-rw.shared-data.svc.cluster.local") : "shared-pg-rw.shared-data.svc.cluster.local"}"
            # #3188 three-instance model: the SAME one-flag contract
            # extends to instance A's third consumer (keycloak — slot 09
            # skips its bundled bitnami postgresql + flips to
            # externalDatabase mode off the keycloak-database-secret hub)
            # and instance B's grafana (slot 25 envFromSecrets
            # `grafana-database-env`; optional=false hard-gates the Pod on
            # the reflector push so grafana can never silently start on
            # sqlite while sharing is live). Slots 16c/16d (shared-pg-b /
            # shared-pg-c) ride the SOVEREIGN_ENABLE_SHARED_PG gate above.
            SOVEREIGN_KEYCLOAK_PG_OWN_CLUSTER: "${enable_shared_pg == "true" ? "false" : "true"}"
            SOVEREIGN_GRAFANA_DB_SECRET_OPTIONAL: "${enable_shared_pg == "true" ? "false" : "true"}"
            # #3370 — the SAME one-flag contract extends to instance B's
            # pda (slot 11a skips the bundled pda-pg Cluster + reads the
            # reflector-pushed pda-shared-database-secret hub directly)
            # and instance C's SME mesh (slot 13 skips the bundled
            # sme-pg Cluster; every SME service + FerretDB dials
            # shared-pg-c-rw with credentials from the sme-database-
            # secret hub — one `sme` role across the three databases).
            #
            # #3486 — the EMBEDDED path (enable_shared_pg=false) now reads the
            # CNPG-generated `pda-pg-app` Secret DIRECTLY (same namespace,
            # always present, carries uri/username/password). The retired
            # `pda-database-secret` reflector PULL-mirror was edge-triggered on
            # the destination and raced the HR uninstall/reinstall remediation
            # churn → stayed empty → PDA CreateContainerConfigError → 15m
            # install timeout → loop forever → wedged bootstrap-kit →
            # sovereign-tls → the wildcard cert → console HTTP 000 (hw134). The
            # shared path still reads the reflector-PUSHED hub directly.
            SOVEREIGN_PDA_PG_OWN_CLUSTER: "${enable_shared_pg == "true" ? "false" : "true"}"
            SOVEREIGN_PDA_PG_SECRET: "${enable_shared_pg == "true" ? "pda-shared-database-secret" : "pda-pg-app"}"
            SOVEREIGN_SME_PG_OWN_CLUSTER: "${enable_shared_pg == "true" ? "false" : "true"}"
            SOVEREIGN_SME_PG_HOST: "${enable_shared_pg == "true" ? "shared-pg-c-rw.shared-data.svc.cluster.local" : ""}"
            SOVEREIGN_SME_PG_SECRET: "${enable_shared_pg == "true" ? "sme-database-secret" : ""}"
            SOVEREIGN_BCP_TOPOLOGY: "${bcp_topology}"
            # SOVEREIGN_REGION_ROLE — this control plane's role in the
            # multi-region topology (primary|secondary). Both providers
            # pass sovereign_region_role (hetzner stamps the literal per
            # CP, huawei derives it from the region index). Promoted out
            # of the huawei-only block for the bp-cnpg-pair split-side
            # model: slot 16b stamps `cnpgPair.side` from this so each
            # cluster renders its own half of the CNPG pair (the chart
            # normalizes "secondary" → replica).
            SOVEREIGN_REGION_ROLE: "${sovereign_region_role}"
            # SECONDARY_HR_SUSPEND and SECONDARY_EDGE_SUSPEND (CLD-133) are
            # computed from the same region role for every provider. They sat
            # in one pack's substitutes only, so a secondary control plane of
            # another pack fell to the kit defaults and ran the primary-only
            # slots (the umbrella bp-catalyst-platform among them, G2 #2574).
            # SECONDARY_HR_SUSPEND is "true" on every secondary control plane:
            # the slots that read it stay suspended there.
            # SECONDARY_EDGE_SUSPEND is its inverse (#5289): kit slot 13e
            # un-suspends only on a secondary control plane, where it proxies
            # the api, console and marketplace hosts to the primary's
            # singletons. A single-region Sovereign has only the primary.
            SECONDARY_HR_SUSPEND: "${sovereign_region_role == "primary" ? "false" : "true"}"
            SECONDARY_EDGE_SUSPEND: "${sovereign_region_role == "primary" ? "true" : "false"}"
            SOVEREIGN_REGIONS_JSON: '${sovereign_regions_json}'
            SOVEREIGN_CONFIGURED_REGIONS_YAML: '${sovereign_configured_regions_yaml}'
%{ if provider_substitutes_yaml != "" ~}
            ${indent(12, chomp(provider_substitutes_yaml))}
%{ endif ~}
            WILDCARD_CERT_ISSUER: "${wildcard_cert_issuer}"
%{ if render_region_kustomization ~}
            SOVEREIGN_REGION_ID: "${region_canonical_label}"
            SOVEREIGN_WRITER_REGION_ID: "${primary_region_canonical_label}"
%{ endif ~}
FLUXBOOTSTRAP
    , "/(?m)^[ ]*#( |$).*\n/", ""), "/(?m)^      /", ""))))}

runcmd:
  - swapoff -a
  - sed -i '/swap/d' /etc/fstab
  - update-alternatives --set iptables /usr/sbin/iptables-legacy || true
  - update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy || true
%{ if node_ipv4_only ~}
  # #3840 — disable IPv6 NOW (before the r4() DNS pin, k3s install + every image
  # pull below) so containerd's Go resolver never receives/dials an unreachable
  # AAAA on this IPv4-only VPC (the `lookup ghcr.io: Try again` 0-HR wedge that
  # #3837's per-host /etc/hosts pin could not deterministically close). The
  # sysctl drop-in written above persists it across any later `sysctl --system`;
  # `sysctl -w` makes it live immediately. Huawei-gated (see the drop-in header).
  - sysctl -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 net.ipv6.conf.lo.disable_ipv6=1 || true
%{ endif ~}

  # Apply inotify-limit bumps + hardened sshd written by write_files.
  - sysctl --system
  - systemctl reload ssh || systemctl reload sshd || true
%{ if enable_fail2ban ~}
  - systemctl enable --now fail2ban || true
%{ endif ~}

  # ── NET-185: the node's own resolver leaves port 53 to dnsdist ─────────
  # dnsdist holds host port 53 on every node (POWERDNS_DNSDIST_HOSTPORT), and
  # Cilium's socket balancer in the host namespace (socketLB.hostNamespaceOnly)
  # sends a host process's packet for any 127.0.0.0/8 address on port 53 to
  # that Pod. Through systemd-resolved's stub (127.0.0.53) the node's own
  # lookups (containerd, kubelet, curl) would reach the Sovereign's
  # authoritative server and fail whenever its Pod is not running. So, before
  # k3s starts and only where systemd-resolved runs, the stub stops listening
  # and /etc/resolv.conf links /run/systemd/resolve/resolv.conf: the network's
  # own servers. The node resolves through them before Cilium and dnsdist run,
  # while they start and after. Where systemd-resolved does not run (the local
  # pack masks it), nothing changes.
  - |
    if systemctl is-active -q systemd-resolved; then
     mkdir -p /etc/systemd/resolved.conf.d
     printf '[Resolve]\nDNSStubListener=no\n' >/etc/systemd/resolved.conf.d/90-no-stub.conf
     systemctl restart systemd-resolved
     ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf
     echo "[resolver] stub off: $(grep -c ^nameserver /etc/resolv.conf) servers"
    else echo "[resolver] systemd-resolved not active: unchanged"; fi

  # ── PROVIDER PRELUDE (injected) ───────────────────────────────────────
  # Runs BEFORE k3s. Only hard cloud-dependency setup that must precede the
  # k3s install: private-NIC bring-up (Hetzner netplan), console-less log
  # self-upload (Huawei #3132), iptables DNAT (Huawei host-bound envoy).
  # Empty on clouds that need none. Each item is plain POSIX (dash -n clean).
  ${indent(2, provider_prelude)}

  # ── IPv4-pin bootstrap hosts (#3232/#3714 — the intermittent multi-region
  # pre-PUT/CNI killer). Huawei VPCs are IPv4-only; the node resolver can
  # hand back an AAAA for these GitHub/helm hosts → curl + Go (helm/kubectl)
  # try IPv6 FIRST → "network is unreachable" with NO A fallback → the
  # github artifact pulls stall. This MUST run BEFORE the k3s install (the
  # very first github-dependent pull: get.k3s.io redirects to the k3s
  # release asset on github) so the PRIMARY-region pre-PUT stall (hw150,
  # k3s/helm/git artifacts never finish → kubeconfig never PUT) cannot
  # recur, AND before the later helm/cilium/flux pulls (region-b CNI-dead,
  # ClusterMesh blocked). The old getent-only probe SILENTLY skipped any
  # host whose IPv4 getent missed, leaving AAAA to win — #3714 makes
  # resolution DETERMINISTIC via a bounded 3-tier ladder (getent →
  # public-resolver nslookup → python3 AF_INET getaddrinfo) before pinning
  # /etc/hosts. POSIX/dash-clean; every host is IPv4-reachable from every
  # cloud (on a dual-stack cloud the resolved A record is still valid).
  #
  # #3735 (2026-06-18 — the hw159 ImagePullBackOff): harbor.openova.io is
  # ALSO dual-stack (A=45.151.123.50 + AAAA). On the IPv4-only Huawei VPC the
  # node's containerd image-pull resolver intermittently gets the AAAA →
  # `dial tcp: lookup harbor.openova.io: Try again` → ImagePullBackOff for any
  # image pulled through the harbor pull-through proxy (catalyst-api,
  # controllers — they can land on a CP node). containerd reads the NODE
  # resolver, NOT pod DNS, so a coredns-custom hosts entry does NOT fix it —
  # the pin MUST be at the node /etc/hosts level (this block). registry.<fqdn>
  # is the POST-CUTOVER local Harbor: pre-cutover it has no DNS record so r4()
  # returns empty and the `[ -n "$a" ]` guard skips it (no bad pin); post-
  # cutover it resolves to the gateway EIP (IPv4) and pins correctly. Both
  # hosts are appended ONLY on huawei: Hetzner is dual-stack (harbor's AAAA is
  # reachable so no pin is needed) AND its CP render sits at 32223/32256 B
  # (#1981 ExternalIP reconciler) — only 33 B of headroom — so the
  # provider-gated conditional keeps the Hetzner render byte-identical while
  # giving every IPv4-only cloud the harbor pin. No hardcoded IP: r4() derives
  # the A record at boot and self-heals if harbor's address ever changes.
  #
  # #4049: image-host pins REMOVED (pulls route via bastion IP 212.72.24.20;
  # #3840 disables IPv6). KEPT: git + helm-repo hosts + registry.<fqdn>.
  #
  # #3714 (2026-06-18 — the kom4dc 0-HR wedge): the /etc/hosts pin below fixes
  # the NODE Go resolvers (helm/kubectl/git/containerd) but does NOT reach the
  # in-cluster Flux source-controller pod, which pulls the bootstrap monorepo
  # from github.com and resolves via CoreDNS, not the node /etc/hosts. On the
  # IPv4-only Huawei VPC a CoreDNS upstream that hands back AAAA makes the
  # source-controller try IPv6 → "network is unreachable" → no GitRepository
  # artifact → 0 HelmReleases in BOTH regions → Phase-1 watcher times out + the
  # kubeconfig is never PUT (the exact hw160 wedge; intermittent per-prov —
  # hw159 got an A record and converged, hw160 got AAAA). #3715 first shipped
  # both halves (node pin + an in-cluster coredns-custom ConfigMap); #3721
  # reverted #3715 wholesale for Hetzner cloud-init bloat, and #3727 re-added
  # ONLY the node half — so the in-cluster half was lost. The CoreDNS step that
  # FOLLOWS (after the CNI is up) restores it, Huawei-gated. To feed that step
  # without duplicating the r4() resolver ladder, on Huawei we ALSO persist
  # every resolved `<ip> <host>` to a side-file the CoreDNS step reads back.
  # Both the side-file and the api.github.com host are Huawei-gated so the
  # byte-tight Hetzner render (only ~49 B headroom under the 32256 cap) stays
  # byte-identical — Hetzner is dual-stack and needs neither.
  - |
%{ if node_ipv4_only ~}
    mkdir -p /var/lib/catalyst
    : >/var/lib/catalyst/github-ipv4-hosts
%{ endif ~}
    r4() {
     a=$(getent ahostsv4 "$1" 2>/dev/null | awk '{print $1; exit}'); [ -n "$a" ] && { echo "$a"; return; }
     for s in 1.1.1.1 8.8.8.8; do
      a=$(nslookup -type=A "$1" "$s" 2>/dev/null | awk '/^Address: [0-9]/&&$2!~/#/{print $2; exit}')
      [ -n "$a" ] && { echo "$a"; return; }
     done
     python3 -c 'import socket,sys;print(socket.getaddrinfo(sys.argv[1],443,2)[0][4][0])' "$1" 2>/dev/null
    }
    for h in github.com raw.githubusercontent.com codeload.github.com objects.githubusercontent.com helm.cilium.io get.helm.sh%{ if node_ipv4_only } api.github.com registry.${sovereign_fqdn}%{ endif ~}; do
     # #4692: retry the resolve. r4() runs once per host, but on a first-boot
     # VPC where external DNS egress (1.1.1.1 / 8.8.8.8) or the local resolver
     # is not yet ready, that single attempt leaves the host UNPINNED and the
     # later helm-repo-add of https://helm.cilium.io/ then fails with no
     # /etc/hosts fallback, so CNI never installs, the node stays NotReady, and
     # 0 HRs reconcile (the #3829 kom4dc wedge that killed hw209/hw210/hw211).
     # Bounded 5x3s max per host; additive — worst case is the prior single-shot
     # no-pin behaviour, never a boot hang. Once pinned, /etc/hosts serves the
     # resolve durably regardless of later live-DNS flakiness.
     a=""
     for attempt in 1 2 3 4 5; do
      a=$(r4 "$h"); [ -n "$a" ] && break
      [ "$attempt" = 5 ] || sleep 3
     done
     [ -n "$a" ] && echo "$a $h" >>/etc/hosts || true
%{ if node_ipv4_only ~}
     [ -n "$a" ] && echo "$a $h" >>/var/lib/catalyst/github-ipv4-hosts
%{ endif ~}
    done

  # ── OpenBao seal: volume and key install (contract C8, SEC-152) ───────
  # Actions 2 and 3 of docs/contracts/c8-seal-provider.md, before the k3s
  # install. Action 2 only when the pack names a seal volume: a missing
  # device stops the boot with code 96 (reserved for this step, checked by
  # scripts/check-cloudinit-exit-codes.py) and k3s never starts; an empty
  # device is formatted once, labelled catalyst-seal and mounted at
  # /var/lib/catalyst/seal through /etc/fstab. Action 3: the directory gets
  # mode 0700 and the owner of the OpenBao container (100:1000), each staged
  # node file is installed at its path, and the stage under /run is removed.
  - |
%{ if seal_volume_device != "" ~}
    [ -b ${seal_volume_device} ] || exit 96
    blkid ${seal_volume_device} >/dev/null 2>&1 || mkfs.ext4 -q -L catalyst-seal ${seal_volume_device}
    grep -q catalyst-seal /etc/fstab || echo 'LABEL=catalyst-seal /var/lib/catalyst/seal ext4 defaults,nodev,nosuid,noexec 0 2' >>/etc/fstab
    mkdir -p /var/lib/catalyst/seal && mount /var/lib/catalyst/seal
%{ endif ~}
    install -d -m 0700 -o 100 -g 1000 /var/lib/catalyst/seal
%{ for f in seal_node_files ~}
    install -m ${f.permissions} -o ${split(":", f.owner)[0]} -g ${split(":", f.owner)[1]} /run/catalyst-seal-stage/${basename(f.path)} ${f.path}
%{ endfor ~}
    rm -rf /run/catalyst-seal-stage

  # ── Install k3s server ────────────────────────────────────────────────
  # NODE_EXTERNAL_IP comes from the provider-injected discovery command:
  #   Hetzner → curl metadata 169.254.169.254/hetzner/v1/.../public-ipv4
  #   Huawei  → printf the tofu-known EIP (HCS metadata doesn't populate it)
  # k3s_extra_args carries provider-specific server flags (OIDC, taints,
  # watch-cache tuning, topology labels). The CNI is disabled (Cilium owns
  # the network from first pod); flannel/servicelb/traefik all off.
  # SEC-020: K3S_TOKEN is the region's random server token; --agent-token is
  # the separate random token that workers join with. The provider module
  # holds both as random_password resources.
  # NET-020: --disable-kube-proxy. Cilium is the only Service proxy
  # (kubeProxyReplacement: true in cilium-values.yaml above), so k3s starts
  # no kube-proxy. Gate check NET-G03 proves it on every node.
  # SEC-030: --secrets-encryption with the secretbox provider. k3s writes
  # every Secret to etcd as ciphertext. The key rests in
  # /var/lib/rancher/k3s/server/cred/encryption-config.json on each server,
  # and in etcd under the server token. Gate check SEC-G01 proves it.
  # SEC-040: --write-kubeconfig-mode=0600. /etc/rancher/k3s/k3s.yaml is
  # readable by root only. Every reader of it here runs in cloud-init as
  # root, and the parent gets a ServiceAccount kubeconfig (SOV-140). Gate
  # check SEC-G02 proves the mode on every control-plane node.
  # AIP-201: from k3s 1.35 on, and only then, the server line also turns on
  # the feature gates ClusterTrustBundle, ClusterTrustBundleProjection and
  # PodCertificateRequest on the API server, controller manager, scheduler
  # and kubelet, and serves certificates.k8s.io/v1beta1. The gVisor runtime of
  # agent runs needs these two APIs (lab test AIP-030). Below 1.35 a k3s server
  # with the gates does not start, so the condition follows k3s_version.
  #
  # #3971 — `--disable=local-storage` FORBIDS the k3s local-path provisioner
  # entirely: it is NEVER installed on a fresh prov. local-path is ephemeral
  # node-local disk (no cloud block volume behind it) — any node replacement
  # destroys the PV's data (prod Postgres 3×100Gi, openbao secrets, customer
  # DB), invalidating BCP/DR. With the provisioner gone, the ONLY default
  # StorageClass is the per-provider cloud CSI: Hetzner → bp-hcloud-csi slot
  # 55a (csi.hetzner.cloud + hcloud-volumes); Huawei → bp-huawei-evs-csi slot
  # 55b (evs.csi.huaweicloud.com + evs-ssd). The stateful root slots (bp-cnpg /
  # bp-mgmt-vcluster) `dependsOn: [bp-hcloud-csi, bp-huawei-evs-csi]` — BOTH
  # CSI slots, so the PROVIDER-CORRECT default class exists BEFORE any PVC
  # binds and nothing hangs Pending (#892: gating on bp-hcloud-csi alone froze
  # Huawei PVCs classless because bp-hcloud-csi renders EMPTY/Ready-with-no-class
  # on Huawei — the durable class there is evs-ssd from slot 55b). Both CSI
  # slots are active-but-empty on the OTHER provider, so neither dependsOn
  # deadlocks. A belt-and-braces Kyverno ENFORCE policy (bp-kyverno-policies
  # K23 forbid-local-path-storage) additionally DENIES any PVC/StorageClass/PV
  # that references local-path. (founder: "local path never ever ALLOWED".)
  #
  # #4858 kubelet image-GC guard — the self-hosting image deadlock. On the
  # mothership (2026-07-08) DiskPressure pushed the node to the kubelet
  # eviction wall (imagefs.available<15%), where the eviction manager purges
  # EVERY unused image — including the locally-hosted Harbor's OWN component
  # images — so all harbor.openova.io-prefixed workloads (Harbor itself +
  # pdns-pg → PowerDNS → global sovereign DNS SERVFAIL) went ImagePullBackOff
  # with nothing left to serve the re-pull. Post-cutover every Sovereign
  # serves its workload images from its LOCAL Harbor (step 03 harbor-prewarm
  # + step 04 registry-pivot), so every node here carries the same circular
  # dependency. Guard, in the k3s kubelet leg (kubelet defaults in parens):
  #   image-gc-high-threshold=70 (85) — periodic image-GC starts at 70% disk,
  #     15 points BEFORE the eviction wall, so reclamation is early and
  #     incremental (LRU order, stops at the low threshold) instead of a
  #     pressure-driven mass purge. In-use images are never GC'd, and a
  #     briefly-bouncing bootstrap-critical pod's image is at the BACK of the
  #     LRU line — unlike eviction reclaim, which takes everything unused.
  #   image-gc-low-threshold=60 (80) — reclaim down to 60%, real headroom for
  #     the image-pull churn of a catalyst-api/platform roll (the #4858
  #     DiskPressure source) instead of the default 5-point shave.
  #   minimum-image-ttl-duration=2h (2m) — a JUST-PULLED image (age counted
  #     from first detection) can't be reaped before its pod starts, so a
  #     roll on a filling disk can't pull→GC→re-pull thrash. Long-resident
  #     unused layers are past the TTL and stay reclaimable, so a genuinely
  #     filling disk still frees space at the 70% trigger.
  # Same guard on the worker templates (both providers) — Harbor/PowerDNS
  # operands schedule on workers too. Refs #4849 (same disk-fill class).
  # BYTE BUDGET: the 3-region Hetzner render sat 34 B under the 32512
  # guardrail, so the ~123 B of kubelet args are paid for by shortening
  # log-only strings (the two k3s FATAL echoes below + two log lines of the
  # image pre-pull, which SOV-149 removed) — exit codes 86/87 and every
  # sentinel file are unchanged.
  - |
    NODE_EXTERNAL_IP=$(${node_external_ip_cmd})
    [ -n "$${NODE_EXTERNAL_IP}" ] || { echo "[k3s] FATAL: no external IP" >&2; exit 87; }
    NODE_IP=$(${node_ip_cmd})
    [ -n "$${NODE_IP}" ] || { echo "[k3s] FATAL: no private IP" >&2; exit 86; }
    # Substitute the runtime-detected private IP into the cilium values +
    # bootstrap-kit substitute map (the NODE_IP_PLACEHOLDER sentinel) so Cilium
    # reaches its OWN apiserver on a real address on every cloud.
    sed -i "s|NODE_IP_PLACEHOLDER|$${NODE_IP}|g" /var/lib/catalyst/cilium-values.yaml /var/lib/catalyst/flux-bootstrap.yaml
    # #5042: k3s is the bootstrap foundation. Old `curl get.k3s.io | ... sh -`
    # silently no-ops on a transient DNS/CDN miss (pipe masks curl's exit; empty
    # stdin → `sh -` exit 0 → k3s never installs → healthz spins forever, hw247
    # forensic-blind). Fix: download-to-FILE (failure visible) then run; 5x
    # linear backoff for the #3232/#3829 class; exhaustion fail-loud (sentinel +
    # exit 88, huawei log-push). Re-run is idempotent.
    # SOV-132: --disable-default-registry-endpoint: a name with an entry in
    # registries.yaml never falls back to its public address, and the
    # wildcard entry gives every other name one (lab test SOV-060).
    # SOV-136: --embedded-registry: every node of this region's cluster serves
    # the images of its containerd store to the others (Spegel; client cert of
    # the cluster CA, preshared key of the server). For every name of
    # registries.yaml containerd asks the peers first, the name's endpoints
    # after them, so a Pod a drain moves pulls from a node that holds its
    # image. Agents take the setting from the server; workers pass no flag.
    for i in 1 2 3 4 5; do
      sh /var/lib/catalyst/oci_fetch k3s-install ${replace(k3s_version, "+", "-")} /var/lib/catalyst/k3s-install.sh https://get.k3s.io \
        && INSTALL_K3S_VERSION=${k3s_version} K3S_TOKEN=${k3s_server_token} \
           INSTALL_K3S_EXEC="server --cluster-init --secrets-encryption --secrets-encryption-provider=secretbox --flannel-backend=none --disable-network-policy --disable-kube-proxy --disable=traefik --disable=servicelb --embedded-registry --disable=local-storage --disable-default-registry-endpoint --cluster-cidr=${cluster_cidr} --service-cidr=${service_cidr} --node-ip=$${NODE_IP} --node-external-ip=$${NODE_EXTERNAL_IP} --advertise-address=$${NODE_IP} --kubelet-arg=max-pods=220 --kubelet-arg=image-gc-high-threshold=70 --kubelet-arg=image-gc-low-threshold=60 --kubelet-arg=minimum-image-ttl-duration=2h --tls-san=${sovereign_fqdn} --tls-san=$${NODE_IP} --tls-san=$${NODE_EXTERNAL_IP} --node-label catalyst.openova.io/role=control-plane --node-label openova.io/region=${region_canonical_label} --agent-token=${k3s_agent_token} ${k3s_extra_args} %{ if tonumber(split(".", k3s_version)[1]) >= 35 }--kube-apiserver-arg=feature-gates=ClusterTrustBundle=true,ClusterTrustBundleProjection=true,PodCertificateRequest=true --kube-apiserver-arg=runtime-config=certificates.k8s.io/v1beta1=true --kube-controller-manager-arg=feature-gates=ClusterTrustBundle=true,ClusterTrustBundleProjection=true,PodCertificateRequest=true --kube-scheduler-arg=feature-gates=ClusterTrustBundle=true,ClusterTrustBundleProjection=true,PodCertificateRequest=true --kubelet-arg=feature-gates=ClusterTrustBundle=true,ClusterTrustBundleProjection=true,PodCertificateRequest=true %{ endif }--write-kubeconfig-mode=0600" \
           sh /var/lib/catalyst/k3s-install.sh \
        && break
      [ "$i" = 5 ] && { echo "[k3s] FATAL: install failed after 5 attempts" >&2; ${fail_mark_cmd}k3s-install-FAILED||true; exit 88; }
      sleep $((i*10))
    done

  # Wait for the API server to be reachable (Cilium comes up later, so we
  # wait specifically for the apiserver /healthz endpoint, not node-Ready).
  # #5042: BOUNDED (was unbounded `until ...; sleep 5` — a dead apiserver hung
  # forever + silently, masquerading as a downstream flux wedge). 120x5s=10m
  # then fail-loud (sentinel + exit 89, huawei log-push).
  - |
    n=0
    until kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml get --raw /healthz >/dev/null 2>&1; do
      n=$((n+1)); [ "$n" -ge 120 ] && { echo "[healthz] FATAL: apiserver never healthy after 120 tries (10m)" >&2; ${fail_mark_cmd}apiserver-healthz-FAILED||true; exit 89; }
      sleep 5
    done

  # #3971 — NO StorageClass is provisioned here. k3s ran with
  # `--disable=local-storage` (above) so the ephemeral local-path provisioner
  # is FORBIDDEN — it is never installed. The cluster comes up with ZERO
  # StorageClasses; the per-provider cloud block-storage CSI installs the
  # durable default SC via Flux (Hetzner: bp-hcloud-csi slot 55a → hcloud-
  # volumes; Huawei: bp-huawei-evs-csi slot 55b → evs-ssd). The stateful root
  # slots (bp-cnpg / bp-mgmt-vcluster) gate on
  # `dependsOn: [bp-hcloud-csi, bp-huawei-evs-csi]` — BOTH CSI slots — so the
  # PROVIDER-CORRECT default class exists before the first PVC binds (#892: the
  # earlier single-CSI gate let Huawei PVCs race ahead of evs-ssd and freeze
  # classless; no Pending-PVC regression now). The former `kubectl patch sc
  # local-path is-default-class=true` block that lived here is DELETED —
  # asserting/defaulting local-path is exactly the anti-pattern #3971 forbids.

%{ if deployment_id != "" && kubeconfig_bearer_token != "" && catalyst_api_url != "" ~}
  # KUBECONFIG PUT-BACK — STRUCTURAL INVARIANT (#3129): runs HERE, right
  # after apiserver /healthz and BEFORE gateway-api/cilium/flux. Nothing
  # downstream can block it. The PUT block is provider-injected (the public-IP
  # source + multi-region gating differ — a hard dependency), but the ORDERING
  # is identical and fixed for every cloud.
  #
  # SOV-140 — revocable parent access. The post-back sends the kubeconfig of
  # ServiceAccount kube-system/parent-bootstrap (bound to cluster-admin; its
  # token Secret kube-system/parent-bootstrap-token has no expiry), never the
  # node's administrator file /etc/rancher/k3s/k3s.yaml. Deleting the
  # ServiceAccount revokes the parent's access. The file is k3s.yaml with its
  # client-certificate lines removed and the token as the user's credential.
  # It exists only until the post-back has run: the item after the post-back
  # deletes it. Fail-loud: sentinel parent-bootstrap-FAILED + exit 98.
  # Written tight: every byte counts against the 32 KiB user-data cap.
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml N=parent-bootstrap S=kube-system K=/var/lib/catalyst/parent-bootstrap.kubeconfig
    for i in $(seq 60); do kubectl apply -f- <<E >/dev/null && T=$(kubectl -n $S get secret $N-token -o jsonpath='{.data.token}') && [ "$T" ] && break
    apiVersion: v1
    kind: ServiceAccount
    metadata: {name: $N, namespace: $S}
    ---
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata: {name: $N}
    roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin}
    subjects: [{kind: ServiceAccount, name: $N, namespace: $S}]
    ---
    apiVersion: v1
    kind: Secret
    type: kubernetes.io/service-account-token
    metadata: {name: $N-token, namespace: $S, annotations: {kubernetes.io/service-account.name: $N}}
    E
    sleep 2; done
    [ "$T" ] && (umask 077; sed /client-/d $KUBECONFIG >$K) && kubectl --kubeconfig=$K config set-credentials default --token="$(echo $T|base64 -d)" || { sh /var/lib/catalyst/mark $N-FAILED || touch /var/lib/catalyst/$N-FAILED; exit 98; }
%{ if sovereign_region_role != "primary" ~}
  # SOV-141 — the peer token. A region that is not the primary also creates
  # ServiceAccount kube-system/handover-peer (cluster-admin; its token Secret
  # kube-system/handover-peer-token has no expiry) and writes its kubeconfig
  # the same way. The provider's post-back sends it under the key
  # peerKubeconfig; the parent gives it to the primary at hand-over. It
  # survives the deletion of parent-bootstrap. The item after the post-back
  # deletes the file. Fail-loud: sentinel handover-peer-FAILED + exit 97.
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml N=handover-peer S=kube-system K=/var/lib/catalyst/handover-peer.kubeconfig
    for i in $(seq 60); do kubectl apply -f- <<E >/dev/null && T=$(kubectl -n $S get secret $N-token -o jsonpath='{.data.token}') && [ "$T" ] && break
    apiVersion: v1
    kind: ServiceAccount
    metadata: {name: $N, namespace: $S}
    ---
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata: {name: $N}
    roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin}
    subjects: [{kind: ServiceAccount, name: $N, namespace: $S}]
    ---
    apiVersion: v1
    kind: Secret
    type: kubernetes.io/service-account-token
    metadata: {name: $N-token, namespace: $S, annotations: {kubernetes.io/service-account.name: $N}}
    E
    sleep 2; done
    [ "$T" ] && (umask 077; sed /client-/d $KUBECONFIG >$K) && kubectl --kubeconfig=$K config set-credentials default --token="$(echo $T|base64 -d)" || { sh /var/lib/catalyst/mark $N-FAILED || touch /var/lib/catalyst/$N-FAILED; exit 97; }
%{ endif ~}
  ${indent(2, kubeconfig_put_block)}
  - rm -f /var/lib/catalyst/parent-bootstrap.kubeconfig
%{ if sovereign_region_role != "primary" ~}
  - rm -f /var/lib/catalyst/handover-peer.kubeconfig
%{ endif ~}
%{ endif ~}

  # ── gateway-api CRDs: ONE official bundle apply (Flux's bp-gateway-api
  # re-applies post-bootstrap; this just unblocks the Cilium gateway-controller).
  # #5042: retried (a single-shot CDN miss killed the whole remaining runcmd).
  # ONE shell so KUBECONFIG is exported once — keeps the byte-tight Hetzner render.
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    for i in 1 2 3 4 5; do sh /var/lib/catalyst/oci_fetch gateway-api-experimental-install v1.1.0 /var/lib/catalyst/gwapi.yaml https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.1.0/experimental-install.yaml && kubectl apply -f /var/lib/catalyst/gwapi.yaml && break; [ "$i" = 5 ] && { ${fail_mark_cmd}gwapi-apply-FAILED||true; exit 95; }; sleep 15; done
    kubectl wait --for=condition=Established crd/tlsroutes.gateway.networking.k8s.io --timeout=60s

  # ── Cilium CNI: helm upgrade --install + retry/fail-fast (#4503) ───────
  # rt() retries each network step 5x/10s; `helm upgrade --install` is
  # idempotent so a retry after a partial register actually recovers
  # (`helm install` would die "cannot re-use a name"). An exhausted retry
  # writes the sentinel + exit 91 so "no CNI" is its own loud fault, never
  # a masqueraded Flux wedge. The set -e stays: runcmd is one script, and
  # the items after this one rely on it (the SEC-040 `(exit $?)` below).
  #
  # #4752 — the cilium rollout-status wait MUST go through `rt` (the 5×/10s
  # retry helper), like every helm step above it. A single-shot
  # `rollout status --timeout=240s || exit 91` aborted the WHOLE bootstrap
  # (Flux never installed → permanent 0-HR wedge) whenever one cilium pod was
  # merely slow. Live evidence (hw222): the wait timed out at "4 of 5 pods
  # available", exit 91 fired, and cilium finished healthy seconds later —
  # too late. Wrapping in `rt` gives cilium up to 5×240s=20m (breaking early
  # the instant it's Ready) while still failing loud on a genuinely dead CNI.
  #
  # The helm installer is downloaded to a file and then run (#5042 did the
  # same for k3s): piped `curl | bash` under sh reported bash's 0 when curl
  # failed, so rt never retried and the boot died at `helm: not found`.
  # Every exhausted step names itself, writes the sentinel and exits 91
  # (scripts/tests/test-cloudinit-first-boot-fails-loudly.sh runs this).
  - |
    set -e
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    rt(){ for i in 1 2 3 4 5;do "$@"&&return;sleep 10;done;echo "[cilium] FATAL: failed 5x: $*" >&2;${fail_mark_cmd}cilium-bootstrap-FAILED||true;exit 91;}
    rt sh -c 'curl -fsSL -o /var/lib/catalyst/get-helm-3 https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3&&bash /var/lib/catalyst/get-helm-3'
    rt helm repo add cilium https://helm.cilium.io/
    rt helm repo update
    rt helm upgrade --install cilium cilium/cilium --version 1.19.3 -n kube-system -f /var/lib/catalyst/cilium-values.yaml
    rt kubectl -n kube-system rollout status ds/cilium --timeout=240s
  # #4503 root cause: on
  # the IPv4-only kom4dc path a single transient failure of get-helm-3 /
  # helm.cilium.io / the chart pull used to be SILENT (cloud-init runcmd is
  # non-fatal) → 0 Cilium objects → nodes NotReady ("cni plugin not
  # initialized") forever → Flux controllers can't schedule → permanent
  # deadlock whose only recorded symptom was the phase-1 watcher's generic
  # "0 HelmReleases" (the WRONG layer; recurrence of #1934, hit on
  # d692b5ed547596cf 2026-06-26). The retry+fail-fast block above makes "no
  # CNI" its own loud fault instead of a masqueraded Flux/ghcr-blob wedge.
%{ if node_ipv4_only ~}
  # ── In-cluster github→IPv4 for the Flux source-controller (#3714) ──────
  # The DEEPER half of the #3232/#3714 fix, restored after the #3721 revert
  # (which kept only the node /etc/hosts pin). The source-controller pod pulls
  # the bootstrap monorepo from github.com and resolves via CoreDNS — NOT the
  # node /etc/hosts — so on the IPv4-only Huawei VPC a CoreDNS upstream that
  # returns AAAA makes it dial IPv6 → "network is unreachable" → no
  # GitRepository artifact → 0 HelmReleases in BOTH regions → Phase-1 watcher
  # times out + the kubeconfig is never PUT (the hw160 wedge). We inject a
  # `coredns-custom` ConfigMap — the k3s-native, restart/upgrade-surviving
  # CoreDNS extension point. We emit a `*.server` file (a SEPARATE server block
  # scoped to the github zones) — NOT a `*.override` file: k3s merges `.override`
  # files into the default `.:53` block, which already carries a
  # `hosts /etc/coredns/NodeHosts` plugin, and two `hosts` plugins in one block
  # is illegal CoreDNS (crash-loop → 0 kube-dns endpoints → in-cluster DNS
  # EPERMs → 0 HRs; the #3804 hw161 wedge). The dedicated `.server` block
  # force-resolves the github hosts to the SAME IPv4 the node pin just resolved
  # (read back from the r4() side-file, so the resolver ladder is NOT
  # duplicated); `hosts ... fallthrough` + a `forward . 8.8.8.8 1.1.1.1` floor
  # keeps every other name in those zones resolving over IPv4. This touches ONLY
  # CoreDNS config, never Cilium/CNI/kube-proxy, so ClusterMesh is unaffected.
  # Runs AFTER the CNI is up (CoreDNS pods can now go Ready + mount the
  # override) and BEFORE Flux is installed/bootstrapped below, so the
  # source-controller resolves github→IPv4 on its first GitRepository attempt.
  # Huawei-only: Hetzner is dual-stack (no in-cluster IPv6 trap) and its render
  # is byte-tight, so the whole block renders empty there. POSIX/dash-clean
  # (printf, no nested heredoc).
  - |
    PIN_FILE=/var/lib/catalyst/github-ipv4-hosts
    CM_FILE=/var/lib/catalyst/coredns-custom-github.yaml
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    # Only the in-cluster-relevant github hosts get the CoreDNS override (the
    # helm.cilium.io / get.helm.sh / harbor / registry pulls all run on the
    # NODE, already pinned in /etc/hosts above — they never hit CoreDNS).
    GH_HOSTS="github.com codeload.github.com objects.githubusercontent.com raw.githubusercontent.com api.github.com"
    # One printf per constant run of lines: every byte counts against the
    # 32 KiB user-data cap, and the restart patch below is longer than the
    # `kubectl rollout restart` it replaced.
    {
     printf 'apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: coredns-custom\n  namespace: kube-system\ndata:\n'
     # `.server` (NOT `.override`): k3s merges `*.override` files INTO the
     # default `.:53` block, which ALREADY carries a `hosts /etc/coredns/NodeHosts`
     # plugin — two `hosts` plugins in one server block is illegal CoreDNS
     # ("plugin/hosts: this plugin can only be used once per Server Block") and
     # CRASH-loops CoreDNS → kube-dns has 0 endpoints → every in-cluster DNS
     # lookup EPERMs → source-controller can't resolve github → 0 HRs (the hw161
     # wedge, #3804 regression). A `*.server` file is a SEPARATE server block
     # scoped to ONLY the github zones, so it never collides with NodeHosts.
     printf '  github-ipv4.server: |\n    %s {\n        hosts {\n' "$GH_HOSTS"
     for h in $GH_HOSTS; do
      ip=$(awk -v host="$h" '$2 == host {print $1; exit}' "$PIN_FILE" 2>/dev/null)
      [ -n "$ip" ] && printf '            %s %s\n' "$ip" "$h"
     done
     printf '            fallthrough\n        }\n        forward . 8.8.8.8 1.1.1.1\n    }\n'
    } >"$CM_FILE"
    # Wait (bounded, 24 x 5s) for the CoreDNS Deployment object — the k3s addon
    # registers it within seconds of the apiserver; the Deployment EXISTS long
    # before its pods are Ready. A missing addon must never stall bootstrap.
    for n in $(seq 24); do kubectl -n kube-system get deploy coredns >/dev/null 2>&1 && break; sleep 5; done
    # Apply the override (idempotent, persists immediately) + nudge a restart.
    # We do NOT block on rollout-status: CoreDNS picks up the mounted override
    # on its next reload, still well before Flux bootstraps the GitRepository.
    # FND-G02 (Zero touch) reads a `kubectl*` field manager or the
    # kubectl.kubernetes.io/restartedAt annotation on a kube-system workload as
    # a hand: first boot writes as catalyst-first-boot and restarts CoreDNS by
    # patching its own catalyst.openova.io/restartedAt + restartedBy.
    M=--field-manager=catalyst-first-boot
    kubectl apply $M -f "$CM_FILE" || true
    kubectl -n kube-system patch deploy coredns $M -p '{"spec":{"template":{"metadata":{"annotations":{"catalyst.openova.io/restartedAt":"'"$(date -u +%FT%TZ)"'","catalyst.openova.io/restartedBy":"catalyst-first-boot"}}}}}' >/dev/null 2>&1 || true
%{ endif ~}

  # SOV-149: first boot pulls no image ahead of time. The two background
  # pre-pull items that stood here are gone: the pull of the Flux controller
  # images and the database image (IPv4-only clouds) and the pull of the
  # platform images, which rendered the catalyst chart from a clone of the
  # GitOps repository and carried the registry token inside runcmd. The lab
  # test SOV-148 (docs/ledger/plan/spikes/SOV-148.md) measured that neither
  # shortens an installation; kubelet pulls every image on demand, through
  # the node's registry mirror (/etc/rancher/k3s/registries.yaml).

%{ if provider_id_cmd != "" ~}
  # ── providerID patch — PROVIDER-INJECTED (best-effort, non-fatal) ─────
  ${indent(2, provider_id_cmd)}
%{ endif ~}

  # ── Flux install + the apiserver-side bootstrap secrets ───────────────
  # #5042(a): the install leg is IDEMPOTENT and gated on the flux CRDs being
  # SERVABLE (kubectl get crd helmreleases.helm.toolkit.fluxcd.io) — NOT on a
  # single kubectl-apply exit 0. hw247 proved the wedge mode: cilium up, flux
  # CRDs absent, phase1-watching forever. The apply retries with bounded
  # linear backoff (10 tries, sleep n*10s ≈ 9m10s of sleep + curl --max-time 60
  # per try, ~20m worst case) to ride out the #3232/#3829 github/ghcr
  # transient-DNS class instead of the old 5x15s ~75s window; a re-run of
  # cloud-init short-circuits on the first CRD probe. Exhaustion stays
  # fail-loud (the mark helper touches the sentinel + exit 93) and now ALSO
  # pushes the cloud-init log (#5042(b)) — never forensic-blind on kom4dc.
  # flux install creates deny-world NetworkPolicies that block source-controller
  # → github.com; delete them (bp-network-policies slot 30 provides the proper
  # zero-trust posture via CCNPs with flux-system allowlisted). ONE shell for the
  # whole leg so KUBECONFIG is exported once — keeps the byte-tight Hetzner render
  # under the 32256B cap; explicit exit 93/94 still halt runcmd fail-loud (#5042).
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    n=0
    until kubectl get crd helmreleases.helm.toolkit.fluxcd.io >/dev/null 2>&1; do
     n=$((n+1)); [ "$n" -gt 10 ] && { ${fail_mark_cmd}flux-install-FAILED||true; exit 93; }
     sh /var/lib/catalyst/oci_fetch flux-install v2.4.0 /var/lib/catalyst/flux.yaml https://github.com/fluxcd/flux2/releases/download/v2.4.0/install.yaml && kubectl apply -f /var/lib/catalyst/flux.yaml || true
     sleep $((n*10))
    done
    kubectl -n flux-system delete networkpolicy allow-egress allow-scraping allow-webhooks --ignore-not-found || true
    for j in 1 2; do kubectl -n flux-system wait --for=condition=Available --timeout=300s deployment --all && break; [ "$j" = 2 ] && { ${fail_mark_cmd}flux-wait-FAILED||true; exit 94; }; done

  # Apply the bootstrap secrets BEFORE Flux reconciles bootstrap-kit (each
  # is an idempotent `kubectl apply`; re-running cloud-init rewrites bytes).
  #
  # #3804 (Refs #3642) — create the CRD-independent bootstrap namespace
  # catalyst-system idempotently FIRST, through the dry-run|apply idiom, so
  # the Secret catalyst-handover-jwt-public lands in an existing namespace.
  # #4513: `kubectl create namespace` accepts EXACTLY ONE positional name
  # ("error: exactly one NAME is required, got 2") — a two-name create died on
  # this FIRST runcmd item, and because cloud-init halts runcmd on a non-zero
  # exit the WHOLE remainder never ran → permanent 0-HR fresh-prov wedge.
  # SEC-153: the kit applies its own Namespace catalyst-system (slot 13) only
  # after the Kustomization bootstrap-secrets is ready, so first boot must
  # create it. It no longer creates openbao: no object of first boot lands
  # there since SEC-040 removed the recovery seed, and kit slot 08 declares
  # that Namespace. The secret applies below run from `cd /var/lib/catalyst`
  # so the `-f` paths drop their dir prefix. (powerdns-api-credentials no
  # longer needs `cert-manager` created here — #3888 evicted it to the Flux
  # sovereign-tls Kustomization.)
  # #5057: ONE shell so KUBECONFIG exports once + every kubectl drops the
  # 38-B --kubeconfig flag — reclaims bytes the #5042 retry loops consumed.
  # SEC-152: the apply creates ConfigMap flux-system/sovereign-seal-profile
  # (contract C8, action 4). It holds no key bytes, so its file is not shredded.
  # The same apply applies the cloud-credentials Secret, the one Secret
  # manifest first boot still writes, with --server-side: a client-side apply
  # stores the whole manifest, so every value, in the annotation
  # kubectl.kubernetes.io/last-applied-configuration of the Secret.
  # SEC-153, SEC-154: then `kubectl create secret` makes the seed Secret
  # flux-system/bootstrap-seed from bootstrap-seed.env; create records no
  # last-applied state either. The Flux Kustomization bootstrap-secrets renders
  # six bootstrap Secrets from it.
  # SEC-040: when the apply and the create succeed (&&), shred -u removes the
  # cloud-credentials file and the seed file, so no bootstrap secret stays on
  # the disk of the node. set -e (from the cilium item) ignores a failed command
  # left of &&, so (exit $?) on the next line stops the boot script with the
  # exit code of a failed apply or create, and the files stay. The template creates
  # no recovery seed for OpenBao: the bp-openbao chart creates that Secret
  # when it is absent (platform/openbao/chart/templates/recovery-seed-bootstrap.yaml).
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    kubectl create namespace catalyst-system --dry-run=client -o yaml | kubectl apply -f -
    cd /var/lib/catalyst
    kubectl apply --server-side -f sovereign-seal-profile.yaml -f cloud-credentials-secret.yaml && kubectl -n flux-system create secret generic bootstrap-seed --from-env-file=bootstrap-seed.env && shred -u cloud-credentials-secret.yaml bootstrap-seed.env
    (exit $?)

  # Hand the cluster to Flux. From here it pulls clusters/_template/ and
  # installs bp-cilium, bp-cert-manager, …, bp-catalyst-platform. #4513: this
  # is THE critical handoff — a silent failure here leaves the cluster at
  # 0 GitRepository/0 HR forever with no recorded symptom. Fail-fast with a
  # sentinel (mirrors the #4503 cilium block) so a flux-bootstrap apply failure
  # is its OWN loud fault (exit 92), not a masqueraded "0 HelmReleases" timeout.
  # Crossplane Provider CR (gated): apply with || true + a detached background
  # retry once core CRDs register — platform plumbing, never on the boot path.
  # #5057: ONE shell so KUBECONFIG exports once + each kubectl drops the 38-B
  # --kubeconfig flag; the exit 92 fail-loud is unchanged. Reclaims #5042 bytes.
  # SOV-134: ConfigMap flux-system/sovereign-variables is created from
  # variables.env first, so the apply of flux-bootstrap.yaml merges the kit
  # keys into it; a failure of either is the same exit 92.
  # SEC-040: after a successful apply flux-bootstrap.yaml is shredded; a
  # failed apply exits 92 before that line.
  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
%{ if crossplane_provider_yaml != "" ~}
    kubectl apply -f /var/lib/catalyst/crossplane-provider.yaml || true
%{ endif ~}
    kubectl -n flux-system create cm sovereign-variables --from-env-file=/var/lib/catalyst/variables.env && kubectl apply -f /var/lib/catalyst/flux-bootstrap.yaml || { ${fail_mark_cmd}flux-bootstrap-FAILED||true; exit 92; }
    shred -u /var/lib/catalyst/flux-bootstrap.yaml
%{ if crossplane_provider_yaml != "" ~}
    nohup bash -c "deadline=\$((SECONDS+1800)); while [ \$SECONDS -lt \$deadline ]; do kubectl apply -f /var/lib/catalyst/crossplane-provider.yaml >/dev/null 2>&1 && break; sleep 30; done" >/dev/null 2>&1 &
%{ endif ~}

  # Marker for the catalyst-api provisioner to detect cloud-init is done.
  - mkdir -p /var/lib/catalyst
  - touch /var/lib/catalyst/cloud-init-complete
  # #5042(b): the final mark on the success path. Where fail_mark_cmd is a
  # helper that pushes the log (the huawei provider_prelude writes it), this is
  # the deterministic FINAL log push: the background uploader caps at ~50 min
  # and can expire before a slow 2-region bootstrap finishes. Re-touching
  # cloud-init-complete is an idempotent no-op.
  - ${fail_mark_cmd}cloud-init-complete||true

final_message: "Catalyst CP bootstrap done; Flux reconciling ${sovereign_fqdn}"
