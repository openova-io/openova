#cloud-config
# Catalyst Sovereign worker bootstrap — Huawei Cloud (Stack).
# Sovereign: ${sovereign_fqdn}
# Provisioned by: catalyst-provisioner

package_update: true
package_upgrade: false
packages:
  - curl
  - iptables
  - jq
  - ca-certificates
%{ if enable_fail2ban ~}
  - fail2ban
%{ endif ~}
%{ if enable_unattended_upgrades ~}
  - unattended-upgrades
%{ endif ~}

write_files:
  # Wave 5.100 (#2447) — k3s-agent containerd registry mirror. Mirrors
  # harbor.openova.io → bastion harbor-cache (212.72.24.20:5000). See
  # cloudinit-control-plane.tftpl Wave 5.100 comment for full rationale.
  - path: /etc/rancher/k3s/registries.yaml
    permissions: '0644'
    content: |
      # Wave 5.106 (#2462): mirror docker.io + registry-1.docker.io through bastion
      # direct dockerhub proxy at :5002 (separate registry:2 instance running on
      # bastion-openova, proxy mode → registry-1.docker.io upstream). Wave 5.105
      # tried port :5000/v2/proxy-dockerhub but containerd appends /v2/<image> →
      # double-/v2/ path (HTTP 404). The :5002 proxy serves /v2/<image> directly,
      # matching containerd's canonical mirror semantics.
      #
      # Why this exists: bp-keycloak postgresql, bp-falco falcoctl, bp-cnpg initdb
      # for gitea/openova-flow/powerdns Postgres clusters — all reference docker.io
      # directly. From Huawei VPC NAT EIPs Cloudflare/Cloudfront DNS resolves
      # intermittently (`dial tcp: lookup production.cloudfront.docker.com: Try
      # again`) → ImagePullBackOff → CNPG postgres init never completes → bp-gitea/
      # bp-catalyst-platform/sov-tls cascading FAIL (hw07 49d43efbaf2a46c2 evidence).
      # Wave 5.109 (#2462 follow-up): extend mirror set to cover ghcr.io
      # (cnpg/flux-controllers/openova-flow/trivy/aquasec all live there),
      # reg.kyverno.io (kyverno admission + reports controllers), quay.io
      # (cert-manager/jetstack and future Calico/Tigera). All flow through
      # dedicated bastion registry:2 proxies — :5003/:5004/:5005 spun up
      # alongside the existing :5000 (harbor.openova.io) + :5002 (docker.io).
      # Live evidence: hw09 6d9eb655 + hw10 4284fe92 — bp-cnpg stuck in
      # ImagePullBackOff on cnpg-cloudnative-pg:1.29.0 (ghcr.io) → cascading
      # bp-openbao/bp-gitea/bp-catalyst-platform.
      mirrors:
        "harbor.openova.io":
          endpoint:
            - "http://212.72.24.20:5000"
        "docker.io":
          endpoint:
            - "http://212.72.24.20:5002"
        "registry-1.docker.io":
          endpoint:
            - "http://212.72.24.20:5002"
        "ghcr.io":
          endpoint:
            - "http://212.72.24.20:5003"
        "reg.kyverno.io":
          endpoint:
            - "http://212.72.24.20:5004"
        "quay.io":
          endpoint:
            - "http://212.72.24.20:5005"
      configs:
        "212.72.24.20:5000":
          tls:
            insecure_skip_verify: true
        "212.72.24.20:5002":
          tls:
            insecure_skip_verify: true
        "212.72.24.20:5003":
          tls:
            insecure_skip_verify: true
        "212.72.24.20:5004":
          tls:
            insecure_skip_verify: true
        "212.72.24.20:5005":
          tls:
            insecure_skip_verify: true

  - path: /etc/sysctl.d/99-catalyst-inotify.conf
    permissions: '0644'
    content: |
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 1048576
      fs.inotify.max_queued_events = 16384

  - path: /etc/ssh/sshd_config.d/99-catalyst-hardening.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      MaxAuthTries 3

runcmd:
  # Wave 5.20: single shell block — cloud-init runcmd list-form had two
  # silent halts on HCS Ubuntu image: (1) apt-get install fails because
  # the mirror is unreachable so fail2ban package isn't installed,
  # (2) bash-wrapped `systemctl enable --now fail2ban` either halts
  # subshell or has env weirdness. One literal-block shell command
  # makes the order explicit: sysctl --system → skip-on-error fail2ban
  # enable → k3s install (the load-bearing step) → mkdir+touch.
  #
  # G48 (Refs #2600, 2026-05-30): replace bounded 10×15s=150s retry-loop
  # with systemd one-shot retry-until-success unit (mirror G46 pattern
  # from cloudinit-control-plane.tftpl). Verified live on hw57 v9 region-a
  # at +31min: 2 of 3 worker ECS ACTIVE on HCS but failed to join k3s after
  # the 10-retry budget exhausted. bp-mimir/bp-harbor/bp-openova-flow-server
  # Pending on insufficient nodes → bootstrap-kit Kustomization stalled →
  # sovereign-tls blocked → Gateway unprogrammed → console unreachable.
  # Target-state per founder mandate "never workaround": systemd retries
  # forever until k3s-agent.service is active, eventually-consistent
  # convergence regardless of any transient CP-readiness / get.k3s.io /
  # network blip.
  - |
    set +e
    sysctl --system
    systemctl reload ssh 2>/dev/null || true
    systemctl enable --now fail2ban 2>/dev/null || true
    # Write the install script.
    cat > /usr/local/bin/openova-k3s-agent-install.sh <<'K3S_INSTALL'
    #!/bin/bash
    set -euo pipefail
    # Idempotency: if k3s-agent.service is already active, exit 0.
    if systemctl is-active k3s-agent >/dev/null 2>&1; then
      echo "openova-k3s-agent-install: k3s-agent already active; nothing to do"
      exit 0
    fi
    # Install via canonical k3s installer (resolves get.k3s.io → fetches
    # binary → systemd unit). Each attempt exits 0 only if both curl|sh
    # and the post-install agent registration succeed.
    if ! curl -sfL --max-time 30 https://get.k3s.io | \
      INSTALL_K3S_VERSION=${k3s_version} \
      K3S_TOKEN=${k3s_token} \
      K3S_URL=https://${cp_private_ip}:6443 \
      INSTALL_K3S_EXEC="agent --node-label=catalyst.openova.io/provider=huawei --node-label=openova.io/region=hw-${region}-rtz-prod --node-label=topology.kubernetes.io/region=${region} --node-label=topology.kubernetes.io/zone=${region}" \
      sh -; then
      echo "openova-k3s-agent-install: get.k3s.io install step failed; exiting nonzero for systemd retry"
      exit 1
    fi
    # Verify k3s-agent registered with CP (give it 30s to come up).
    for i in $(seq 1 6); do
      if systemctl is-active k3s-agent >/dev/null 2>&1; then
        echo "openova-k3s-agent-install: SUCCESS k3s-agent active"
        mkdir -p /var/lib/catalyst
        touch /var/lib/catalyst/worker-bootstrap-complete
        exit 0
      fi
      sleep 5
    done
    echo "openova-k3s-agent-install: k3s-agent did NOT become active within 30s of install; exiting nonzero for systemd retry"
    exit 1
    K3S_INSTALL
    chmod 0755 /usr/local/bin/openova-k3s-agent-install.sh
    # Write the systemd unit.
    cat > /etc/systemd/system/openova-k3s-agent-install.service <<'K3S_UNIT'
    [Unit]
    Description=OpenOva k3s-agent install + register with retry-until-success
    After=network-online.target
    Wants=network-online.target
    StartLimitIntervalSec=0
    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/bin/openova-k3s-agent-install.sh
    Restart=on-failure
    RestartSec=30
    [Install]
    WantedBy=multi-user.target
    K3S_UNIT
    systemctl daemon-reload
    systemctl enable openova-k3s-agent-install.service
    # Try once now (non-blocking — systemd retries every 30s on failure).
    systemctl start openova-k3s-agent-install.service || true
    # Wait up to 300s for first success so cloud-init exits with a useful
    # marker. If wait expires, systemd keeps retrying in the background.
    for i in $(seq 1 60); do
      if systemctl is-active k3s-agent >/dev/null 2>&1; then
        echo "G48: k3s-agent active via systemd after $((i*5))s"
        break
      fi
      sleep 5
    done

