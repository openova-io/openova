#cloud-config
# Worker machine of the local provider pack. It joins the k3s server of its
# region's control-plane machine. The k3s binary comes from the k3s release
# and is checked against the release's own checksum file.
write_files:
  - path: /etc/rancher/k3s/registries.yaml
    permissions: '0600'
    content: |
      ${indent(6, registry_mirror_yaml)}
  - path: /etc/rancher/k3s/config.yaml
    permissions: '0600'
    content: |
      server: https://${cp_private_ip}:6443
      token: ${k3s_token}
      node-ip: ${node_ip}
      node-label:
        - catalyst.openova.io/role=worker
        - topology.kubernetes.io/region=${region}
        - topology.kubernetes.io/zone=${region}
  - path: /etc/systemd/system/k3s-agent.service
    permissions: '0644'
    content: |
      [Unit]
      Description=k3s agent
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=notify
      ExecStartPre=-/sbin/modprobe br_netfilter
      ExecStartPre=-/sbin/modprobe overlay
      ExecStart=/usr/local/bin/k3s agent
      KillMode=process
      Delegate=yes
      LimitNOFILE=1048576
      LimitNPROC=infinity
      LimitCORE=infinity
      TasksMax=infinity
      TimeoutStartSec=0
      Restart=always
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target
runcmd:
  - mkdir -p /var/lib/catalyst
  - |
    cd /tmp
    for i in 1 2 3 4 5; do
      curl -fsSL --max-time 300 -o k3s '${k3s_release_url}/k3s' \
        && curl -fsSL --max-time 60 -o k3s.sha256 '${k3s_release_url}/sha256sum-amd64.txt' \
        && grep ' k3s$' k3s.sha256 | sha256sum -c - \
        && break
      [ "$i" = 5 ] && { echo "[k3s] FATAL: download or checksum failed after 5 attempts" >&2; touch /var/lib/catalyst/k3s-install-FAILED; exit 88; }
      sleep $((i*10))
    done
    install -m 0755 k3s /usr/local/bin/k3s
    rm -f k3s k3s.sha256
  - systemctl daemon-reload
  - systemctl enable --now k3s-agent.service
  - touch /var/lib/catalyst/cloud-init-complete
