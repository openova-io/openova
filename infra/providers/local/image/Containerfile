# Machine image of the local provider pack: Ubuntu 22.04 that boots like a
# cloud image. systemd is PID 1, and cloud-init reads its user-data from the
# NoCloud seed directory that the module fills. Nothing of the bootstrap
# template is baked in.
FROM ubuntu:22.04

ENV container=docker \
    DEBIAN_FRONTEND=noninteractive

# Packages that an Ubuntu server cloud image carries and the container base lacks.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus cloud-init openssh-server sudo \
      iproute2 iptables kmod ca-certificates curl openssl gnupg \
      python3 netbase lsb-release bind9-dnsutils iputils-ping \
      netcat-openbsd less tzdata locales \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Units that only make sense on a real machine, or that wait for a network
# manager the container does not use. systemd-resolved is masked so that the
# DNS server of the kit can bind port 53 on the machine's own address.
RUN systemctl mask \
      systemd-networkd-wait-online.service systemd-networkd.service \
      systemd-resolved.service systemd-timesyncd.service \
      systemd-udevd.service systemd-udevd-control.socket systemd-udevd-kernel.socket \
      getty@tty1.service console-getty.service \
      sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
      systemd-modules-load.service \
 && systemctl set-default multi-user.target

# On a virtual machine systemd marks / as a shared mount; in a container it
# does not. The kubelet needs shared propagation for the mounts of the CNI.
COPY make-rshared.service /etc/systemd/system/make-rshared.service
RUN systemctl enable make-rshared.service

# cloud-init reads the NoCloud seed only and leaves the network to the
# container engine.
COPY 99-local-pack.cfg /etc/cloud/cloud.cfg.d/99-local-pack.cfg
RUN mkdir -p /var/lib/cloud/seed/nocloud \
 && rm -f /etc/machine-id /var/lib/dbus/machine-id \
 && rm -f /etc/ssh/ssh_host_*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
