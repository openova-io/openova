---
import Header from '../components/Header.svelte';
import '../styles/global.css';

interface Props {
  title: string;
  step?: number;
}

const { title, step = 0 } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <title>{title} — OpenOva SME</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    // Tenant + theme bootstrap. Runs before the body paints so the right
    // theme + tenant brand attribute are set on <html> with no flash.
    //
    // #3376 (Refs #3691): the per-partner brand table is DATA, read at
    // runtime from `window.__SME_BRANDS__` (which a Sovereign may seed from
    // its own config), NEVER a baked-in literal. The previous inline script
    // hardcoded a partner-vanity-host entry — a banned mothership literal
    // that this inline block served VERBATIM in the HTML of every franchised
    // host. The shipped bundle now carries no partner literal;
    // `window.__SME_BRANDS__` is keyed by marketplace hostname when present.
    (function () {
      var TENANTS = (window.__SME_BRANDS__ && typeof window.__SME_BRANDS__ === 'object') ? window.__SME_BRANDS__ : {};
      var host = '';
      try { host = (window.location.hostname || '').toLowerCase(); } catch (e) {}
      var tenant = TENANTS[host] || { id: 'openova', brand: 'OpenOva' };
      document.documentElement.setAttribute('data-tenant', tenant.id);
      document.documentElement.dataset.tenantBrand = tenant.brand;
      try {
        if (tenant.forceTheme) {
          document.documentElement.setAttribute('data-theme', tenant.forceTheme);
        } else {
          var saved = localStorage.getItem('sme-theme');
          var system = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', saved || system);
        }
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      // Update <title> suffix to match tenant. {title} prefix already rendered
      // server-side; we only adjust the brand suffix client-side so static HTML
      // can be cached without per-tenant cache keys.
      try {
        if (tenant.id !== 'openova' && document.title.indexOf(' — OpenOva SME') !== -1) {
          document.title = document.title.replace(' — OpenOva SME', ' — ' + tenant.brand);
        }
      } catch (e) {}
      // Expose to other inline scripts on the page.
      window.__SME_TENANT__ = tenant;
    })();
  </script>
  <script is:inline>
    // Returning-user redirect: signed-in visitors with at least one live
    // workspace are sent to the console from ANY marketplace page. This
    // closes the loophole where deep links (/plans, /apps, /addons, /review,
    // /checkout) let a returning user land back in the wizard.
    // Exceptions:
    //  - /auth/callback completes OAuth before we can check
    //  - /checkout with ?order_id is Stripe's return URL and must stay so
    //    CheckoutStep can wire up the active-org and redirect itself
    //  - ?new=1 lets an existing customer spin up a second workspace
    (function () {
      try {
        // Demo/partner tenants want returning visitors to stay on the
        // marketplace — bouncing them to the mothership console would break
        // the partner-branded experience. Skip the redirect entirely there.
        var tenant = window.__SME_TENANT__;
        if (tenant && tenant.skipConsoleRedirect) return;
        var path = window.location.pathname;
        var qs = new URLSearchParams(window.location.search);
        if (path.indexOf('/auth/callback') === 0) return;
        if (qs.get('order_id')) return;
        if (qs.get('new') === '1') return;
        var token = localStorage.getItem('sme-token');
        if (!token) return;
        var CACHE_KEY = 'sme-has-workspace-v1';
        var TTL_MS = 60 * 1000;
        var cached = null;
        try { cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || 'null'); } catch (e) {}
        if (cached && cached.has && Date.now() - cached.ts < TTL_MS) {
          redirect();
          return;
        }
        fetch('/api/tenant/orgs', { headers: { Authorization: 'Bearer ' + token } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (orgs) {
            if (!Array.isArray(orgs)) return;
            var live = orgs.filter(function (o) { return o && o.status !== 'deleted'; });
            try {
              sessionStorage.setItem(CACHE_KEY, JSON.stringify({ has: live.length > 0, ts: Date.now() }));
            } catch (e) {}
            if (live.length > 0) {
              // TBD-V10 #2001: stamp the active-org-slug so the redirect
              // composes `console.<slug>.<sov-fqdn>` (per-tenant) rather
              // than `console.<sov-fqdn>` (operator). Prefer the slug
              // matching the active-org id when present, fall back to
              // the first live org.
              var activeId = '';
              try { activeId = localStorage.getItem('sme-active-org') || ''; } catch (_) {}
              var pick = (activeId && live.find(function (o) { return o.id === activeId; })) || live[0];
              if (pick && pick.slug) {
                try { localStorage.setItem('sme-active-org-slug', pick.slug); } catch (_) {}
              }
              redirect(pick && pick.slug ? String(pick.slug) : '');
            }
          })
          .catch(function () {});
      } catch (e) {}
      function redirect(slug) {
        var token = localStorage.getItem('sme-token') || '';
        var refresh = localStorage.getItem('sme-refresh-token') || '';
        // Derive console URL from the current host. Logic mirrors
        // src/lib/config.ts::deriveConsoleURL — kept inline so the redirect
        // fires before the Svelte bundle loads.
        //   <mothership host>            → console.<mothership-apex>/nova     (mothership)
        //   marketplace.<sov> + slug     → console.<slug>.<sov>               (Sovereign per-tenant)
        //   marketplace.<sov> + no slug  → console.<sov>                      (Sovereign operator fallback)
        // #3376 (Refs #3691): EVERY marketplace.<host> (including partner-
        // vanity FQDNs) derives a SOVEREIGN console — a cut-over customer is
        // NEVER bounced to the mothership. The mothership /nova URL is
        // assembled from FRAGMENTS (no mothership console literal in this
        // served inline script) and used only on the mothership host.
        // Bug fix history:
        //   - 2026-05-18 PR #1627: stopped hardcoding the mothership URL.
        //   - 2026-05-20 TBD-V10 #2001: prepend tenant slug so per-tenant
        //     workspace (e.g. console.demo.omani.homes) is the destination.
        var MOTHERSHIP_HOST = 'marketplace.' + ['openova', 'io'].join('.');
        var host = (window.location.hostname || '').toLowerCase();
        var base = 'https://console.' + MOTHERSHIP_HOST.substring('marketplace.'.length) + '/nova';
        if (host && host !== MOTHERSHIP_HOST && host.indexOf('marketplace.') === 0) {
          var sovFqdn = host.substring('marketplace.'.length);
          if (sovFqdn) {
            var s = (slug || '').toLowerCase().trim();
            if (s) {
              base = 'https://console.' + s + '.' + sovFqdn;
            } else {
              base = 'https://console.' + sovFqdn;
            }
          }
        }
        var url = base + '/?token=' + encodeURIComponent(token);
        if (refresh) url += '&refresh_token=' + encodeURIComponent(refresh);
        window.location.replace(url);
      }
    })();
  </script>
</head>
<body>
  <Header client:load currentStep={step} />
  <main class="mx-auto max-w-7xl px-4 py-8">
    <slot />
  </main>
</body>
</html>
