# sovereign-ops runs the life-cycle actions of a Sovereign as Kubernetes Jobs
# (core/cmd/sovereign-ops). .github/workflows/build-sovereign-ops.yaml builds
# this file with the repository root as the build context.
#
# Besides the binary, the image carries the tools its subcommands run: git,
# helm and cosign from the Alpine community packages, and tofu at the
# version and checksums of products/catalyst/bootstrap/api/Containerfile
# (change both files together).

FROM docker.io/library/golang:1.27-alpine AS build
WORKDIR /src/core/cmd/sovereign-ops
# The module requires core/controllers through its replace directive
# (../../controllers). Only what it builds from is copied: the module file
# and the shared packages.
COPY core/controllers/go.mod core/controllers/go.sum /src/core/controllers/
COPY core/controllers/pkg/ /src/core/controllers/pkg/
COPY core/cmd/sovereign-ops/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sovereign-ops .

FROM docker.io/library/alpine:3.20 AS tofu
ARG TARGETARCH=amd64
ARG TOFU_VERSION=1.11.6
ARG TOFU_SHA256_AMD64=02800fafa2753a9f50c38483e2fdf5bc353fd62895eb9e25eec9a5145df3a69e
ARG TOFU_SHA256_ARM64=d4f2ab15776925864b049bb329d69682851de6f5204f256e9fa86d07a0308850
RUN apk add --no-cache ca-certificates curl tar \
    && case "${TARGETARCH}" in \
        amd64) TOFU_SHA256="${TOFU_SHA256_AMD64}" ;; \
        arm64) TOFU_SHA256="${TOFU_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/tofu.tar.gz \
        "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && echo "${TOFU_SHA256}  /tmp/tofu.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/tofu.tar.gz -C /tmp tofu \
    && install -D -m 0755 /tmp/tofu /out/tofu \
    && /out/tofu version

FROM docker.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates git helm cosign \
    && git --version && helm version --short && cosign version
COPY --from=tofu /out/tofu /usr/local/bin/tofu
COPY --from=build /out/sovereign-ops /usr/local/bin/sovereign-ops
# UID 65534 is nobody; the numeric form satisfies runAsNonRoot.
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/sovereign-ops"]
