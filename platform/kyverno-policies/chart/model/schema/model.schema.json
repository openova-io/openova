{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openova.io/schemas/compliance-model/model.schema.json",
  "title": "model/model.yaml of the policy chart: ComplianceModel.spec without checks and exemptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "levels", "mandatoryCap", "severityWeights", "groups", "axes"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "levels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "min"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "min": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "mandatoryCap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "environmentTypes"],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "environmentTypes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "severityWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"$ref": "#/$defs/weight"},
        "high": {"$ref": "#/$defs/weight"},
        "medium": {"$ref": "#/$defs/weight"},
        "low": {"$ref": "#/$defs/weight"}
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weight"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "weight": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "group", "type", "naText"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "group": {"$ref": "#/$defs/id"},
          "type": {"enum": ["checks", "measure"]},
          "measure": {"enum": ["runtime-clean", "memory-efficiency"]},
          "naText": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"type": {"const": "measure"}}},
        "then": {"required": ["measure"]},
        "else": {"not": {"required": ["measure"]}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "weight": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
