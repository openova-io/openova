{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["refs/heads/main"], "exclude": []}},
  "bypass_actors": [{"actor_type": "Team", "team": "release-writer", "bypass_mode": "always"}],
  "rules": [
    {"type": "merge_queue", "parameters": {
      "merge_method": "SQUASH", "grouping_strategy": "ALLGREEN",
      "max_entries_to_build": 5, "max_entries_to_merge": 5,
      "min_entries_to_merge": 5, "min_entries_to_merge_wait_minutes": 5,
      "check_response_timeout_minutes": 120}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": false,
      "required_status_checks": [{"context": "ci-gate"}, {"context": "scope"}, {"context": "acceptance"}]}},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 0, "require_code_owner_review": true,
      "dismiss_stale_reviews_on_push": false, "require_last_push_approval": false,
      "required_review_thread_resolution": false}},
    {"type": "non_fast_forward"},
    {"type": "deletion"}
  ]
}
