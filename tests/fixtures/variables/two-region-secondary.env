# Laid over today.env by scripts/check-freshprov-image-registry.sh --list-images: the second
# value set the image list of a fresh install is rendered with, a region of a two-region install.
# These are the keys infra/providers/_shared/cloudinit-control-plane.tftpl sets otherwise when
# var.regions holds two regions and the control plane is the secondary: slot 62 (the continuum
# controller) is switched on, the primary-only releases are suspended, the secondary edge runs.
CONTINUUM_ENABLED=true
SOVEREIGN_BCP_TOPOLOGY=active-hotstandby
SOVEREIGN_ENABLE_HOT_STANDBY=true
SOVEREIGN_REGION_ROLE=secondary
SECONDARY_HR_SUSPEND=true
SECONDARY_EDGE_SUSPEND=false
SOVEREIGN_REGION_CANONICAL_LABEL=secondary
SOVEREIGN_REGION_ID=secondary
SOVEREIGN_REGION_KEY=region-b
SOVEREIGN_REPLICA_REGION=secondary
SOVEREIGN_REGIONS_JSON=[{"primary":true,"region":"region-a"},{"primary":false,"region":"region-b"}]
SOVEREIGN_CONFIGURED_REGIONS_YAML=["region-a","region-b"]
