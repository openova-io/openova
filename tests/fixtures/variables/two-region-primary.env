# Laid over today.env by the edge-hosts step of .github/workflows/tree-guards.yaml: the value set
# of the PRIMARY control plane of a two-region install, the counterpart of two-region-secondary.env.
# These are the keys infra/providers/_shared/cloudinit-control-plane.tftpl sets otherwise when
# var.regions holds two regions and the control plane is the primary: slot 62 (the continuum
# controller) is switched on, the primary-only releases run, the secondary edge is suspended.
CONTINUUM_ENABLED=true
SOVEREIGN_BCP_TOPOLOGY=active-hotstandby
SOVEREIGN_ENABLE_HOT_STANDBY=true
SOVEREIGN_REGION_ROLE=primary
SECONDARY_HR_SUSPEND=false
SECONDARY_EDGE_SUSPEND=true
SOVEREIGN_REGION_CANONICAL_LABEL=primary
SOVEREIGN_REGION_ID=primary
SOVEREIGN_REGION_KEY=region-a
SOVEREIGN_REPLICA_REGION=secondary
SOVEREIGN_REGIONS_JSON=[{"primary":true,"region":"region-a"},{"primary":false,"region":"region-b"}]
SOVEREIGN_CONFIGURED_REGIONS_YAML=["region-a","region-b"]
